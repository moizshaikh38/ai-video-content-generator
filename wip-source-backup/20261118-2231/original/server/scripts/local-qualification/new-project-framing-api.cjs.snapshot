// LOCAL ONLY: real Studio panel inline crop, desktop/touch apply/cancel, save/reload and bounded720p API.
const fs=require('fs'),cp=require('child_process'),assert=require('assert/strict'),puppeteer=require('/tmp/vireo-local-restore/ui-driver/node_modules/puppeteer-core');
const procs=[];let browser;let restore;
(async()=>{
 fs.rmSync('/tmp/vireo-source-cache/3271c21a7e774b27e0e482d9ffb2fb30a619563a288193e33f1445aede7b07bb.mp4',{force:true});
 const fixture='/tmp/vireo-local-restore/mixed-full-auto-fixture.json';const f=JSON.parse(fs.readFileSync(fixture));
 const {MongoClient}=require('/home/sandbox/avcg/server/node_modules/mongodb');const mc=await MongoClient.connect('mongodb://127.0.0.1:27019');const coll=mc.db('vireo_recovery_qualification').collection('editor_projects');const clips=mc.db('vireo_recovery_qualification').collection('clips'),oldClip=await clips.findOne({id:f.clip_id});const original=await coll.findOne({id:f.editor_id});restore=async()=>{await coll.replaceOne({id:f.editor_id},original);await clips.replaceOne({id:f.clip_id},oldClip);await mc.close()};
 for(const [bin,args,cwd,env,log] of [
  ['/home/sandbox/avcg/server/node_modules/.bin/tsx',['scripts/local-qualification/render-recovered.mts'],'/home/sandbox/avcg/server',{KEEP_LOCAL_SERVER:'1',QUALIFICATION_FIXTURE:fixture,QUALIFICATION_SOURCE:'/downloads/recovered-source/mixed-framing-36s.mp4'},'/tmp/mobile-api.log'],
  ['/home/sandbox/avcg/node_modules/.bin/vite',['--host','127.0.0.1','--port','5199'],'/home/sandbox/avcg',{VITE_API_URL:'http://127.0.0.1:5581/api'},'/tmp/mobile-vite.log']]){
  const p=cp.spawn(bin,args,{cwd,env:{...process.env,...env},detached:true,stdio:['ignore',fs.openSync(log,'w'),fs.openSync(log,'a')]});procs.push(p);
 }
 for(let n=0;n<300;n++){try{if(fs.readFileSync('/tmp/mobile-api.log','utf8').includes('LOCAL_UI_SERVER_READY')&&(await fetch('http://127.0.0.1:5199/harness-studio-e2e.html')).ok)break}catch{}await new Promise(r=>setTimeout(r,100))}
 browser=await puppeteer.launch({executablePath:'/usr/bin/google-chrome',headless:true,args:['--no-sandbox','--disable-dev-shm-usage'],defaultViewport:{width:390,height:844,isMobile:true,hasTouch:true}});
 const page=await browser.newPage(),errors=[],writes=[],metrics=[];
 page.on('response',res=>{if(res.request().method()==='PATCH'&&res.url().includes('/api/')){assert.equal(res.status(),200)}});page.on('pageerror',e=>errors.push(e.message));page.on('request',r=>{if(r.url().includes('/api/')&&['PATCH','DELETE'].includes(r.method()))writes.push(r.url())});
 await page.goto('http://127.0.0.1:5199/harness-studio-e2e.html?clip='+f.clip_id,{waitUntil:'domcontentloaded'});
 const clickText=async(text)=>{if(text.startsWith('Panel ')||text==='Crop')await openTools();await page.waitForFunction(text=>[...document.querySelectorAll('button')].some(b=>b.textContent.trim()===text),{},text);await page.evaluate(text=>[...document.querySelectorAll('button')].find(b=>b.textContent.trim()===text).click(),text)};
 const slots=async()=>{const st=await(await fetch('http://127.0.0.1:5581/api/editor-projects/'+f.editor_id,{headers:{authorization:'Bearer e2e-studio-token'}})).json();return (st.data||st.project||st).tracks.find(t=>t.type==='VIDEO').items[0].panels.slots};
 const save=async()=>{const expected=writes.length+2;await clickText('Save');for(let i=0;i<100&&writes.length<expected;i++)await new Promise(r=>setTimeout(r,100));assert.equal(writes.length,expected);await new Promise(r=>setTimeout(r,200))};
 const openTools=async()=>{const t=await page.$('[data-testid="mobile-framing-toggle"]');if(t&&await t.evaluate(e=>getComputedStyle(e.parentElement).display!=='none'&&e.getAttribute('aria-expanded')==='false'))await t.click()};
 const pick=async label=>{await openTools();await page.click('[data-testid="toolbar-layout"]');await page.waitForSelector('[role="menu"]',{visible:true});await page.evaluate(label=>[...document.querySelectorAll('[role="menuitemradio"]')].find(b=>b.textContent.trim()===label).click(),label);await save()};


 await page.setViewport({width:1440,height:1000,isMobile:false,hasTouch:false});
 const db=mc.db('vireo_recovery_qualification');const created=[];const headers={authorization:'Bearer e2e-studio-token','content-type':'application/json'};
 try{for(const genre of ['watch_party','streaming','gaming']){
 const cr=await fetch('http://127.0.0.1:5581/api/projects',{method:'POST',headers,body:JSON.stringify({title:'Local new Auto ON '+genre,source_type:'upload',clip_preferences:{genre,genreSelectionMode:'manual'}})});const cb=await cr.json();assert.equal(cr.status,201,JSON.stringify(cb));const p=cb.project;created.push(p.id);assert.deepEqual(p.clip_preferences.framingDefaults,{version:1,layout:'auto',autoReframe:true});
 const clip=structuredClone(oldClip);delete clip._id;clip.id=require('crypto').randomUUID();clip.project_id=p.id;clip.crop_config={mode:'smart',layout_mode:'screencast',layout_mode_source:'genre_recommendation'};clip.start_seconds=0;clip.end_seconds=4;clip.duration_seconds=4;clip.trim_start_offset=0;clip.trim_end_offset=0;
 await db.collection('projects').updateOne({id:p.id},{$set:{source_url:f.source_key,video_status:'uploaded',duration_seconds:36}});await db.collection('clips').insertOne(clip);
 const er=await fetch('http://127.0.0.1:5581/api/clips/'+clip.id+'/editor-project',{method:'POST',headers,body:'{}'});assert.equal(er.status,200,await er.clone().text());let e=(await er.json()).data,v=e.tracks.find(t=>t.type==='VIDEO').items[0];assert.equal(v.panels,undefined);assert.equal(v.crop,undefined);assert.equal(v.crop_config.layout_mode_source,'auto');assert.equal(v.automatic_framing.enabled,true);
 if(genre==='watch_party'){await page.goto('http://127.0.0.1:5199/harness-studio-e2e.html?clip='+clip.id,{waitUntil:'domcontentloaded'});await page.waitForSelector('[data-testid=auto-reframe-toggle]');await page.waitForFunction(()=>[...document.querySelectorAll('video')].some(v=>v.videoWidth>0&&v.readyState>=2));await new Promise(r=>setTimeout(r,300));assert.equal(await page.$eval('[data-testid=auto-reframe-toggle]',e=>e.getAttribute('aria-pressed')),'true');assert.ok(await page.$eval('[data-testid=toolbar-layout]',e=>e.textContent.includes('Auto: Fit')));await page.screenshot({path:'/downloads/new-watchparty-auto-on-default.png'});
 const rr=await fetch('http://127.0.0.1:5581/api/editor-projects/'+e.id+'/render',{method:'POST',headers,body:JSON.stringify({resolution:'720p'})});assert.equal(rr.status,202,await rr.text());let status;for(let n=0;n<180;n++){await new Promise(r=>setTimeout(r,250));status=await db.collection('render_jobs').findOne({clip_id:clip.id},{sort:{created_at:-1}});if(['completed','failed'].includes(status?.status))break;}assert.equal(status.status,'completed',JSON.stringify(status));const rc=await db.collection('clips').findOne({id:clip.id});fs.copyFileSync('/tmp/vireo-local-restore/objects/local-clips/'+rc.output_storage_path,'/downloads/new-watchparty-auto-safe-fit-4s.mp4');console.log('NEW_AUTO_NO_ANALYSIS_SAFE_FIT_RENDER_PASS');}

 // An explicit scene OFF/manual edit survives the actual get-or-create/reopen path.
 v.automatic_framing={enabled:false,freeze_source_time:2};v.crop={mode:'fill',focusX:.23,focusY:.5};v.crop_config.layout_mode_source='user';
 const pr=await fetch('http://127.0.0.1:5581/api/editor-projects/'+e.id,{method:'PATCH',headers,body:JSON.stringify({tracks:e.tracks})});assert.equal(pr.status,200);
 const re=await fetch('http://127.0.0.1:5581/api/clips/'+clip.id+'/editor-project',{method:'POST',headers,body:'{}'});e=(await re.json()).data;v=e.tracks.find(t=>t.type==='VIDEO').items[0];assert.equal(v.automatic_framing.enabled,false);assert.equal(v.crop.focusX,.23);
 console.log('ACTUAL_NEW_PROJECT_EDITOR_AUTO_ON_MANUAL_OFF_REOPEN_PASS',genre);
 const policy={defaultLayout:'fit',allowed:['fit','fill']};const pp=await fetch('http://127.0.0.1:5581/api/projects/'+p.id,{method:'PATCH',headers,body:JSON.stringify({clip_preferences:{...p.clip_preferences,layoutPolicy:policy}})});assert.equal(pp.status,200);assert.deepEqual((await pp.json()).project.clip_preferences.layoutPolicy,policy);
 const nextClip={...clip,id:require('crypto').randomUUID()};delete nextClip._id;await db.collection('clips').insertOne(nextClip);const nr=await fetch('http://127.0.0.1:5581/api/clips/'+nextClip.id+'/editor-project',{method:'POST',headers,body:'{}'});assert.equal(nr.status,200);const nv=(await nr.json()).data.tracks.find(t=>t.type==='VIDEO').items[0];assert.equal(nv.crop.mode,'blur');assert.equal(nv.crop.band,'4:3');console.log('SAVED_PROJECT_POLICY_NEW_EDITOR_FIT_GEOMETRY_PASS',genre);
 }}finally{for(const id of created){await db.collection('editor_projects').deleteMany({project_id:id});const cs=await db.collection('clips').find({project_id:id}).toArray();await db.collection('editor_projects').deleteMany({clip_id:{$in:cs.map(c=>c.id)}});await db.collection('render_jobs').deleteMany({clip_id:{$in:cs.map(c=>c.id)}});await db.collection('clips').deleteMany({project_id:id});await db.collection('projects').deleteOne({id});}}
})().catch(e=>{console.error(e);process.exitCode=1}).finally(async()=>{if(browser)await browser.close();for(const p of procs){try{process.kill(-p.pid,'SIGTERM')}catch{}}if(restore)await restore()});
