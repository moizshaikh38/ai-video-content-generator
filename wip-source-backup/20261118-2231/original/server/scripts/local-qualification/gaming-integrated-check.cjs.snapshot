const http=require('http'),fs=require('fs'),path=require('path'),assert=require('assert/strict'),puppeteer=require('/tmp/vireo-local-restore/ui-driver/node_modules/puppeteer-core');
const root='/tmp/vireo-gaming-clean-build/dist',route='/tools/ai-gaming-clip-generator/';
(async()=>{const server=http.createServer((req,res)=>{let p=path.join(root,decodeURIComponent(req.url.split('?')[0]));if(fs.existsSync(p)&&fs.statSync(p).isDirectory())p+='/index.html';if(!p.startsWith(root)||!fs.existsSync(p)){res.writeHead(404).end();return}const ext=path.extname(p);res.setHeader('Content-Type',({'.html':'text/html','.css':'text/css','.js':'application/javascript','.mp4':'video/mp4','.jpg':'image/jpeg','.png':'image/png','.ttf':'font/ttf'})[ext]||'application/octet-stream');res.end(fs.readFileSync(p))});await new Promise(r=>server.listen(5214,'127.0.0.1',r));let browser;try{browser=await puppeteer.launch({executablePath:'/usr/bin/google-chrome',headless:true,args:['--no-sandbox']});const errors=[],failed=[];for(const width of [1280,390,320]){const page=await browser.newPage();page.on('pageerror',e=>errors.push(e.message));page.on('response',r=>{if(r.status()>=400)failed.push({url:r.url(),status:r.status()})});await page.setViewport({width,height:900});await page.emulateMediaFeatures([{name:'prefers-reduced-motion',value:'reduce'}]);const response=await page.goto('http://127.0.0.1:5214'+route,{waitUntil:'networkidle0'});assert.equal(response.status(),200);assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth),false);assert.ok(await page.$$eval('img',a=>a.every(i=>i.complete&&i.naturalWidth>0)));await page.screenshot({path:`/downloads/gaming-integrated-${width}.png`,fullPage:false});assert.ok(await page.$$eval('.showcase video',vs=>vs.every(v=>v.paused)));await page.click('[data-filter=racing]');assert.equal(await page.$$eval('[data-category]',es=>es.filter(e=>getComputedStyle(e).display!=='none').length),1);await page.click('[data-filter=all]');await page.click('[data-layout=focus]');assert.equal(await page.$eval('#layout-video source',e=>e.getAttribute('src')),'media/focus.mp4');await page.click('.faq-list summary');assert.equal(await page.$eval('.faq-list details',e=>e.open),true);assert.ok(await page.$$eval('a[href="/dashboard"]',a=>a.length>=3));await page.close()}
const page=await browser.newPage();await page.setViewport({width:1280,height:900});await page.goto('http://127.0.0.1:5214'+route,{waitUntil:'networkidle0'});await page.waitForFunction(()=>[...document.querySelectorAll('.showcase video')].every(v=>!v.paused&&v.currentTime>0&&v.muted));await page.click('#hero-play');assert.ok(await page.$$eval('.showcase video',vs=>vs.every(v=>v.paused)));await page.click('#hero-play');await page.waitForFunction(()=>[...document.querySelectorAll('.showcase video')].every(v=>!v.paused));assert.deepEqual(errors,[]);assert.deepEqual(failed,[]);console.log('INTEGRATED_STATIC_BUILD_PASS: route/assets/fonts/media loaded, no JS errors/overflow 1280/390/320, reduced motion, hero playback/pause, filter/layout/FAQ/CTA target checks. App CTA destination auth and production rewrites not tested.');}finally{if(browser)await browser.close();server.close()}})().catch(e=>{console.error(e);process.exitCode=1});
