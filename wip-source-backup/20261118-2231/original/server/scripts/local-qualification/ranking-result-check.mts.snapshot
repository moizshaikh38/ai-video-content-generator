import fs from 'node:fs';import {parseCandidateRanking} from './semantic-ranking-contract.js';
const folder='/downloads/vireo-autolayout-eval/';const r=JSON.parse(fs.readFileSync(folder+'ranking-response.json','utf8'));const content=r.choices[0].message.content;const parsed=JSON.parse(content);const cases=parsed.cases.map((x:any)=>{const {caseId,...v}=x;return {caseId,...parseCandidateRanking(v,[{id:'A',geometryQualified:false,manualWitnessOnly:false},{id:'B',geometryQualified:false,manualWitnessOnly:false}])};});
const result={scope:'Two case diagnostic only, no product integration',strictJsonParsed:true,cases,verdict:'FAILED_UTILITY_STOP',observedErrors:['Studio output invents readable-overlay loss despite no readable overlay in supplied source.','Studio working-equipment loss is generic and fails to identify clipped microphone.','Studio selects candidateA with uncertaintyfalse despite listing losses; fail-closed parser abstains.','Harbor abstains but supplies no explicit visible losses, not a successful detailed context review.'],conclusion:'Candidate-ID ranking avoids invented coordinates but did not establish reliable editorial/context evidence. No further paid calls or automatic adoption justified.'};fs.writeFileSync(folder+'ranking-evaluation.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result,null,2));
