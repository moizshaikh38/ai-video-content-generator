import fs from 'node:fs';import {SmartReframeService as S} from '../../src/services/smartReframeService.js';import {SmartReframeService as B} from '../../src/services/temporaryPreviousSmartReframe.js';
const results=[];for(const name of ['walking','studio','pair','mixed','beast']){const t=JSON.parse(fs.readFileSync(`/tmp/vireo-local-restore/${name}-full-auto-analysis.json`,'utf8')),m=t.metadata;const opts={rawSamples:t.raw_samples,sceneCuts:m.scene_cuts,duration:m.clip_duration,sourceWidth:t.source_width,sourceHeight:t.source_height,windowScope:'shot' as const,automaticFitAspect:'4:3' as const,allowConversationSplit:m.conversation_split_candidate===true,protectedContentRegions:m.protected_content_regions};const before=B.computeShotComposition(opts),after=S.computeShotComposition(opts);results.push({name,sourceWidth:t.source_width,sourceHeight:t.source_height,duration:m.clip_duration,before,after});console.log(name,JSON.stringify(after.map((a,i)=>({start:a.start,kind:a.kind,before:[before[i].windowW,before[i].windowH],after:[a.windowW,a.windowH]})).filter(a=>JSON.stringify(a.before)!==JSON.stringify(a.after))));}fs.writeFileSync('/downloads/vireo-autolayout-eval/fit43-natural-ablation.json',JSON.stringify(results,null,2));
