// LOCAL ONLY: real Studio panel inline crop, desktop/touch apply/cancel, save/reload and bounded720p API.
const fs=require('fs'),cp=require('child_process'),assert=require('assert/strict'),puppeteer=require('/tmp/vireo-local-restore/ui-driver/node_modules/puppeteer-core');
const procs=[];let browser;let restore;
(async()=>{
 fs.rmSync('/tmp/vireo-source-cache/3271c21a7e774b27e0e482d9ffb2fb30a619563a288193e33f1445aede7b07bb.mp4',{force:true});
 const fixture='/tmp/vireo-local-restore/mixed-full-auto-fixture.json';const f=JSON.parse(fs.readFileSync(fixture));
 const {MongoClient}=require('/home/sandbox/avcg/server/node_modules/mongodb');const mc=await MongoClient.connect('mongodb://127.0.0.1:27019');const coll=mc.db('vireo_recovery_qualification').collection('editor_projects');const clips=mc.db('vireo_recovery_qualification').collection('clips'),oldClip=await clips.findOne({id:f.clip_id});const original=await coll.findOne({id:f.editor_id});restore=async()=>{await coll.replaceOne({id:f.editor_id},original);await clips.replaceOne({id:f.clip_id},oldClip);await mc.close()};
 for(const [bin,args,cwd,env,log] of [
  ['/home/sandbox/avcg/server/node_modules/.bin/tsx',['scripts/local-qualification/render-recovered.mts'],'/home/sandbox/avcg/server',{KEEP_LOCAL_SERVER:'1',QUALIFICATION_FIXTURE:fixture,QUALIFICATION_SOURCE:'/downloads/recovered-source/mixed-framing-36s.mp4'},'/tmp/mobile-api.log'],
  ['/home/sandbox/avcg/node_modules/.bin/vite',['--host','127.0.0.1','--port','5199'],'/home/sandbox/avcg',{VITE_API_URL:'http://127.0.0.1:5581/api'},'/tmp/mobile-vite.log']]){
  const p=cp.spawn(bin,args,{cwd,env:{...process.env,...env},detached:true,stdio:['ignore',fs.openSync(log,'w'),fs.openSync(log,'a')]});procs.push(p);
 }
 for(let n=0;n<300;n++){try{if(fs.readFileSync('/tmp/mobile-api.log','utf8').includes('LOCAL_UI_SERVER_READY')&&(await fetch('http://127.0.0.1:5199/harness-studio-e2e.html')).ok)break}catch{}await new Promise(r=>setTimeout(r,100))}
 browser=await puppeteer.launch({executablePath:'/usr/bin/google-chrome',headless:true,args:['--no-sandbox','--disable-dev-shm-usage'],defaultViewport:{width:390,height:844,isMobile:true,hasTouch:true}});
 const page=await browser.newPage(),errors=[],writes=[],metrics=[];
 page.on('response',res=>{if(res.request().method()==='PATCH'&&res.url().includes('/api/')){assert.equal(res.status(),200)}});page.on('pageerror',e=>errors.push(e.message));page.on('request',r=>{if(r.url().includes('/api/')&&['PATCH','DELETE'].includes(r.method()))writes.push(r.url())});
 await page.goto('http://127.0.0.1:5199/harness-studio-e2e.html?clip='+f.clip_id,{waitUntil:'domcontentloaded'});
 const clickText=async(text)=>{if(text.startsWith('Panel ')||text==='Crop')await openTools();await page.waitForFunction(text=>[...document.querySelectorAll('button')].some(b=>b.textContent.trim()===text),{},text);await page.evaluate(text=>[...document.querySelectorAll('button')].find(b=>b.textContent.trim()===text).click(),text)};
 const slots=async()=>{const st=await(await fetch('http://127.0.0.1:5581/api/editor-projects/'+f.editor_id,{headers:{authorization:'Bearer e2e-studio-token'}})).json();return (st.data||st.project||st).tracks.find(t=>t.type==='VIDEO').items[0].panels.slots};
 const save=async()=>{const expected=writes.length+2;await clickText('Save');for(let i=0;i<100&&writes.length<expected;i++)await new Promise(r=>setTimeout(r,100));assert.equal(writes.length,expected);await new Promise(r=>setTimeout(r,200))};
 const openTools=async()=>{const t=await page.$('[data-testid="mobile-framing-toggle"]');if(t&&await t.evaluate(e=>getComputedStyle(e.parentElement).display!=='none'&&e.getAttribute('aria-expanded')==='false'))await t.click()};
 const pick=async label=>{await openTools();await page.click('[data-testid="toolbar-layout"]');await page.waitForSelector('[role="menu"]',{visible:true});await page.evaluate(label=>[...document.querySelectorAll('[role="menuitemradio"]')].find(b=>b.textContent.trim()===label).click(),label);await save()};

 await page.setViewport({width:1440,height:1000,isMobile:false,hasTouch:false});await page.waitForSelector('[data-testid="toolbar-layout"]');
 await page.click('[aria-label="Fit to Timeline"]');
 await page.waitForFunction(()=>document.querySelectorAll('[data-testid="automatic-scene-range"]').length===3);
 const read=async()=>{const q=await(await fetch('http://127.0.0.1:5581/api/editor-projects/'+f.editor_id,{headers:{authorization:'Bearer e2e-studio-token'}})).json();return q.data};
 const before=await read();const videos=before.tracks.find(t=>t.type==='VIDEO').items;assert.equal(videos.length,1);console.log('BEFORE',JSON.stringify(videos.map(i=>({id:i.id,start:i.timeline_start,end:i.timeline_end}))));
 await page.screenshot({path:'/downloads/timeline-layout-auto-ranges-before.png'});

 const choose=async(label,whole=false)=>{await page.waitForSelector('[role="menu"]',{visible:true});if(whole)await page.click('[data-testid="layout-scope-whole"]');await page.evaluate(label=>[...document.querySelectorAll('[role="menuitemradio"]')].find(b=>b.textContent.trim()===label).click(),label);await save()};
 await page.$$eval('[data-testid="scene-layout-range-button"]',bs=>bs[1].click());await page.screenshot({path:'/downloads/scene-override-menu.png'});await choose('Fill');
 let q=await read(),vi=q.tracks.find(t=>t.type==='VIDEO').items;assert.equal(vi.length,1);assert.equal(vi[0].crop,undefined);assert.equal(vi[0].scene_layout_overrides.length,1);assert.equal(vi[0].scene_layout_overrides[0].layout,'fill');assert.equal(vi[0].scene_layout_overrides[0].start,12);assert.equal(vi[0].scene_layout_overrides[0].end,24);
 assert.deepEqual(vi[0].tracker,videos[0].tracker);assert.deepEqual(vi[0].crop_config,videos[0].crop_config);
 await page.reload({waitUntil:'domcontentloaded'});await page.waitForSelector('[data-testid="toolbar-layout"]');await page.waitForFunction(()=>[...document.querySelectorAll('video')].some(v=>v.videoWidth>0));await page.click('[aria-label="Fit to Timeline"]');await new Promise(r=>setTimeout(r,500));await page.screenshot({path:'/downloads/scene-override-fill-reloaded.png'});
 q=await read();assert.equal(q.tracks.find(t=>t.type==='VIDEO').items.length,1);assert.equal(q.tracks.find(t=>t.type==='VIDEO').items[0].scene_layout_overrides[0].layout,'fill');
 const res=await fetch('http://127.0.0.1:5581/api/editor-projects/'+f.editor_id+'/render',{method:'POST',headers:{authorization:'Bearer e2e-studio-token','content-type':'application/json'},body:JSON.stringify({resolution:'720p'})});assert.equal(res.status,202,await res.text());let st;for(let i=0;i<480;i++){await new Promise(r=>setTimeout(r,250));st=await(await fetch('http://127.0.0.1:5581/__qualification/status')).json();if(['completed','failed'].includes(st.job?.status))break;}assert.equal(st.job.status,'completed',JSON.stringify(st.job));fs.copyFileSync('/tmp/vireo-local-restore/objects/local-clips/'+st.clip.output_storage_path,'/downloads/scene-override-middle-fill-36s.mp4');
 console.log('ONE_SCENE_FILL_SAVE_RELOAD_RENDER_PASS',JSON.stringify(q.tracks.find(t=>t.type==='VIDEO').items[0].scene_layout_overrides));
 // Canvas right-click uses the current source scene, same no-cut path.
 const canvas=await page.$('[data-testid="preview-layout-canvas"]');await canvas.click({button:'right'});await page.waitForSelector('[role="menu"]',{visible:true});await page.screenshot({path:'/downloads/scene-canvas-rightclick-menu.png'});await choose('Fit');q=await read();assert.equal(q.tracks.find(t=>t.type==='VIDEO').items.length,1);assert.equal(q.tracks.find(t=>t.type==='VIDEO').items[0].scene_layout_overrides[0].layout,'fit');console.log('CANVAS_RIGHTCLICK_SAME_SCENE_SCOPE_PASS');
 await page.reload({waitUntil:'domcontentloaded'});await page.waitForSelector('[data-testid=toolbar-layout]');await page.click('[aria-label="Fit to Timeline"]');const rr=await fetch('http://127.0.0.1:5581/api/editor-projects/'+f.editor_id+'/render',{method:'POST',headers:{authorization:'Bearer e2e-studio-token','content-type':'application/json'},body:JSON.stringify({resolution:'720p'})});assert.equal(rr.status,202,await rr.text());for(let n=0;n<480;n++){await new Promise(r=>setTimeout(r,250));st=await(await fetch('http://127.0.0.1:5581/__qualification/status')).json();if(['completed','failed'].includes(st.job?.status))break;}assert.equal(st.job.status,'completed');fs.copyFileSync('/tmp/vireo-local-restore/objects/local-clips/'+st.clip.output_storage_path,'/downloads/rightclick-scene-fit-36s.mp4');console.log('CANVAS_RIGHTCLICK_FIT_RELOAD_EXPORT_PASS');
 await page.$$eval('[data-testid="scene-layout-range-button"]',bs=>bs[1].click());await choose('Auto');q=await read();assert.equal(q.tracks.find(t=>t.type==='VIDEO').items[0].scene_layout_overrides[0].layout,'auto');console.log('ONE_SCENE_AUTO_RESTORE_PASS');
 await page.$$eval('[data-testid="scene-layout-range-button"]',bs=>bs[1].click());await choose('Fit',true);q=await read();vi=q.tracks.find(t=>t.type==='VIDEO').items;assert.equal(vi.length,1);assert.equal(vi[0].scene_layout_overrides,undefined);assert.equal(vi[0].crop.choice,'fit');console.log('SEPARATE_WHOLE_CLIP_CLEAR_PASS');
 const trimmed=structuredClone(before);const ti=trimmed.tracks.find(t=>t.type==='VIDEO').items[0];Object.assign(ti,{source_start:12,source_end:36,timeline_start:0,timeline_end:12,speed:{speed:2}});trimmed.canvas.duration=12;trimmed.playhead=2;
 const pr=await fetch('http://127.0.0.1:5581/api/editor-projects/'+f.editor_id,{method:'PATCH',headers:{authorization:'Bearer e2e-studio-token','content-type':'application/json'},body:JSON.stringify({tracks:trimmed.tracks,canvas:trimmed.canvas,playhead:2})});assert.equal(pr.status,200);
 await page.reload({waitUntil:'domcontentloaded'});await page.waitForSelector('[data-testid="scene-layout-range-button"]');await page.click('[aria-label="Fit to Timeline"]');assert.equal(await page.$$eval('[data-testid="scene-layout-range-button"]',bs=>bs.length),2);assert.ok(await page.$$eval('[data-testid="scene-layout-range-button"]',bs=>bs.some(b=>b.textContent.includes('Auto Split'))));await page.$$eval('[data-testid="scene-layout-range-button"]',bs=>bs[0].click());await choose('Fill');
 q=await read();vi=q.tracks.find(t=>t.type==='VIDEO').items;assert.equal(vi.length,1);assert.equal(vi[0].source_start,12);assert.equal(vi[0].scene_layout_overrides[0].start,12);assert.equal(vi[0].scene_layout_overrides[0].end,24);
 const sr=await fetch('http://127.0.0.1:5581/api/editor-projects/'+f.editor_id+'/render',{method:'POST',headers:{authorization:'Bearer e2e-studio-token','content-type':'application/json'},body:JSON.stringify({resolution:'720p'})});assert.equal(sr.status,202,await sr.text());for(let i=0;i<480;i++){await new Promise(r=>setTimeout(r,250));st=await(await fetch('http://127.0.0.1:5581/__qualification/status')).json();if(['completed','failed'].includes(st.job?.status))break;}assert.equal(st.job.status,'completed',JSON.stringify(st.job));fs.copyFileSync('/tmp/vireo-local-restore/objects/local-clips/'+st.clip.output_storage_path,'/downloads/scene-override-trim12-speed2-12s.mp4');console.log('TRIM_SOURCE12_SPEED2_SCENE_OVERRIDE_RENDER_PASS');
 await page.reload({waitUntil:'domcontentloaded'});await page.waitForSelector('[data-testid="scene-layout-range-button"]');await page.$$eval('[data-testid="scene-layout-range-button"]',bs=>bs[1].click());await page.keyboard.press('Escape');await page.waitForFunction(()=>[...document.querySelectorAll('video')].filter(v=>v.videoWidth>0&&v.readyState>=2&&!v.seeking).length>=2);await new Promise(r=>setTimeout(r,350));await page.screenshot({path:'/downloads/trim-speed-retained-auto-split-preview.png'});assert.ok(await page.$eval('[data-testid=toolbar-layout]',e=>e.textContent.includes('Split')));console.log('TRIM_SPEED_RELOAD_PREVIEW_RETAINED_SPLIT_PASS');
assert.deepEqual(errors,[]);
})().catch(e=>{console.error(e);process.exitCode=1}).finally(async()=>{if(browser)await browser.close();for(const p of procs){try{process.kill(-p.pid,'SIGTERM')}catch{}}if(restore)await restore()});
