import fs from 'node:fs';import {SmartReframeService as S} from '../../src/services/smartReframeService.js';
for(const name of ['beast-full-auto','beast-evidence-v2']){const t=JSON.parse(fs.readFileSync(`/tmp/vireo-local-restore/${name}-analysis.json`,'utf8')),m=t.metadata;for(const [tag,cuts,split,regions] of [['current',m.scene_cuts,false,m.protected_content_regions],['no-text-diagnostic',m.scene_cuts,false,[]],['split-eligible-diagnostic',m.scene_cuts,true,m.protected_content_regions],['no-cuts-diagnostic',[],false,m.protected_content_regions]] as const){const p=S.computeShotComposition({rawSamples:t.raw_samples,sceneCuts:cuts,duration:m.clip_duration,sourceWidth:t.source_width,sourceHeight:t.source_height,windowScope:'shot',automaticFitAspect:'4:3',allowConversationSplit:split,protectedContentRegions:regions as any});console.log(name,tag,JSON.stringify(p.map(s=>({start:s.start,end:s.end,kind:s.kind,split:!!s.split,fill:s.kind==='solo'&&Math.abs(s.windowW*t.source_width/(s.windowH*t.source_height)-9/16)<.01,review:s.contextStatus}))));}}
