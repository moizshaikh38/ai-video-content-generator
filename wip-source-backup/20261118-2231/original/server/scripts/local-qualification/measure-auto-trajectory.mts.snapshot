import fs from 'node:fs';import {SmartReframeService as S} from '../../src/services/smartReframeService.js';
const r=JSON.parse(fs.readFileSync('/tmp/vireo-local-restore/walking-full-auto-analysis.json','utf8'));const p=S.computeShotComposition({rawSamples:r.raw_samples,sceneCuts:r.metadata.scene_cuts,duration:r.metadata.clip_duration,sourceWidth:r.source_width,sourceHeight:r.source_height,windowScope:'shot',automaticFitAspect:'4:3'});console.log(JSON.stringify(p,null,2));fs.writeFileSync('/downloads/walking-automatic-plan.json',JSON.stringify(p,null,2));for(const s of p){const xs=s.keyframes.map(k=>k.centerX),ys=s.keyframes.map(k=>k.centerY);console.log('TRAJECTORY',{knots:s.keyframes.length,centerXRange:Math.max(...xs)-Math.min(...xs),centerYRange:Math.max(...ys)-Math.min(...ys),sourceMotionPixelsX:(Math.max(...xs)-Math.min(...xs))*r.source_width,window:[s.windowW,s.windowH]})}
