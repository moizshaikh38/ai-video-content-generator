import fs from 'node:fs';import {persistentObjectRegions} from '../../src/shared/objectContext.js';import {SmartReframeService as S} from '../../src/services/smartReframeService.js';
const r=JSON.parse(fs.readFileSync('/tmp/vireo-local-restore/beast-object-context-analysis.json','utf8'));
const p=S.computeShotComposition({rawSamples:r.raw_samples,sceneCuts:r.metadata.scene_cuts,duration:r.metadata.clip_duration,sourceWidth:r.source_width,sourceHeight:r.source_height,windowScope:'shot',automaticFitAspect:'4:3',protectedContentRegions:r.metadata.protected_content_regions});
const rows=p.map(s=>({start:s.start,end:s.end,kind:s.kind,windowW:s.windowW,windowH:s.windowH,contextStatus:s.contextStatus,objects:persistentObjectRegions(r.raw_samples.filter((v:any)=>v.time>=s.start&&v.time<s.end))}));fs.writeFileSync('/downloads/beast-object-context-plan.json',JSON.stringify(rows,null,2));console.log(JSON.stringify({samples:r.raw_samples.length,rawBoxes:r.raw_samples.reduce((n:number,s:any)=>n+(s.objects?.length||0),0),supportedShots:rows.filter(s=>s.objects.length).length,objects:rows.filter(s=>s.objects.length).map(s=>({start:s.start,end:s.end,objects:s.objects}))},null,2));
