import fs from 'node:fs';Object.assign(process.env,{MONGODB_URI:'mongodb://127.0.0.1:27019',MONGODB_DB_NAME:'vireo_recovery_qualification'});const {getMongoDb,closeMongo}=await import('../../src/db/mongoClient.js');const f=JSON.parse(fs.readFileSync('/tmp/vireo-local-restore/beast-full-auto-fixture.json','utf8'));const db=await getMongoDb();console.log(await db.collection('reframe_tracks').updateOne({clip_id:f.clip_id},{$set:{'metadata.automatic_fit_aspect':'4:3','metadata.protected_content_regions':JSON.parse(fs.readFileSync('/tmp/full-auto-ocr/regions.json','utf8'))}}));const r=JSON.parse(fs.readFileSync('/tmp/vireo-local-restore/beast-full-auto-analysis.json','utf8'));r.metadata.automatic_fit_aspect='4:3';r.metadata.protected_content_regions=JSON.parse(fs.readFileSync('/tmp/full-auto-ocr/regions.json','utf8'));fs.writeFileSync('/tmp/vireo-local-restore/beast-full-auto-analysis.json',JSON.stringify(r));await closeMongo();
