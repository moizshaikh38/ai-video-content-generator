import fs from'node:fs';import{execFileSync}from'node:child_process';import ffmpeg from'ffmpeg-static';import{ProEditorService as P}from'../../src/services/proEditorService.js';
const root='/downloads/tracker-speed-proof';fs.mkdirSync(root,{recursive:true});const source=root+'/source.mp4';execFileSync(ffmpeg!,['-y','-v','error','-f','lavfi','-i','color=c=green:s=1920x1080:r=15:d=18,drawbox=x=0:y=0:w=500:h=1080:color=red:t=fill,drawbox=x=1400:y=0:w=520:h=1080:color=blue:t=fill','-c:v','libx264','-threads','1','-preset','ultrafast',source],{timeout:30000});
const i:any={id:'v',type:'VIDEO',source_start:10,source_end:18,timeline_start:0,timeline_end:4,speed:{speed:2},transform:{position_x:0,position_y:0,scale:1,rotation:0,opacity:1},effects:[],keyframes:[],tracker:{enabled:true,source_width:1920,source_height:1080,keyframes:[10,14,18].map((time,n)=>({time,centerX:.2+n*.3,centerY:.5}))}};
const p:any={canvas:{aspect_ratio:'9:16',width:1080,height:1920,fps:30,duration:4},tracks:[{type:'VIDEO',name:'Video',items:[i]}]};const g=P.compileRenderGraph(p,source,root+'/after.mp4',root,{mode:'manual',aspectRatio:'9:16',clipStartSec:10,track:null,sourceHasAudio:false,canvasScale:2/3}as any,'off');fs.writeFileSync(root+'/compiled.json',JSON.stringify(g,null,2));
execFileSync(ffmpeg!,['-y','-v','error','-filter_complex_threads','1','-threads','1','-ss','10',...g.inputArgs,'-filter_complex',g.filterComplex.join(';'),'-map',g.videoMap,'-map',g.audioMap,'-t','4','-c:v','libx264','-threads','1','-preset','ultrafast','-c:a','aac',root+'/after.mp4'],{timeout:30000});
for(const t of[0,.5,2,3.8])execFileSync(ffmpeg!,['-y','-v','error','-ss',String(t),'-i',root+'/after.mp4','-frames:v','1',root+'/'+t+'.png']);

i.tracker.keyframes=[12,14,16].map((time,n)=>({time,centerX:.2+n*.3,centerY:.5}));const multi=P.compileRenderGraph(p,source,root+'/partial.mp4',root,{mode:'manual',aspectRatio:'9:16',clipStartSec:10,track:null,sourceHasAudio:false,canvasScale:2/3}as any,'off');fs.writeFileSync(root+'/partial-compiled.json',JSON.stringify(multi,null,2));execFileSync(ffmpeg!,['-y','-v','error','-filter_complex_threads','1','-threads','1',...multi.inputArgs,'-filter_complex',multi.filterComplex.join(';'),'-map',multi.videoMap,'-map',multi.audioMap,'-t','4','-c:v','libx264','-threads','1','-preset','ultrafast','-c:a','aac',root+'/partial.mp4'],{timeout:30000});for(const t of[.5,1.1,2.8,3.5])execFileSync(ffmpeg!,['-y','-v','error','-ss',String(t),'-i',root+'/partial.mp4','-frames:v','1',root+'/partial-'+t+'.png']);
