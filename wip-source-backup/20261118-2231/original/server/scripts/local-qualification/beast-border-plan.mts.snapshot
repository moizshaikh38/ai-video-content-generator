import fs from 'node:fs';import {SmartReframeService as S} from '../../src/services/smartReframeService.js';
const t=JSON.parse(fs.readFileSync('/tmp/vireo-local-restore/beast-full-auto-analysis.json','utf8')),v=JSON.parse(fs.readFileSync('/tmp/vireo-local-restore/beast-border-fixed-cv.json','utf8'));S.associateTracks(v.samples,.35,t.metadata.scene_cuts);const m=t.metadata;const opts={sceneCuts:m.scene_cuts,duration:m.clip_duration,sourceWidth:t.source_width,sourceHeight:t.source_height,windowScope:'shot' as const,automaticFitAspect:'4:3' as const,allowConversationSplit:false,protectedContentRegions:m.protected_content_regions};const old=S.computeShotComposition({...opts,rawSamples:t.raw_samples}),now=S.computeShotComposition({...opts,rawSamples:v.samples});const rows=now.map((s,i)=>({start:s.start,end:s.end,before:old[i],after:s}));fs.writeFileSync('/downloads/vireo-autolayout-eval/beast-border-plan.json',JSON.stringify(rows,null,2));console.log(JSON.stringify(rows.filter((s)=>JSON.stringify(s.before)!==JSON.stringify(s.after)),null,2));
