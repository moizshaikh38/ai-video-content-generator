import fs from 'node:fs';
import {SmartReframeService as S} from '../../src/services/smartReframeService.js';
const t=JSON.parse(fs.readFileSync('/tmp/vireo-local-restore/beast-full-auto-analysis.json','utf8'));
const m=t.metadata,p=S.computeShotComposition({rawSamples:t.raw_samples,sceneCuts:m.scene_cuts,duration:m.clip_duration,sourceWidth:t.source_width,sourceHeight:t.source_height,windowScope:'shot',automaticFitAspect:'4:3',allowConversationSplit:m.conversation_split_candidate===true,protectedContentRegions:m.protected_content_regions});
const rows=p.map(s=>{const samples=t.raw_samples.filter((x:any)=>x.time>=s.start&&x.time<s.end),ids=new Map<string,number>();for(const a of samples)for(const f of a.faces||[])if(f.track_id)ids.set(f.track_id,(ids.get(f.track_id)||0)+1);const eligible=[...ids].filter(([,n])=>n>=Math.max(2,samples.length*.35));return {start:s.start,end:s.end,seconds:Number((s.end-s.start).toFixed(3)),samples:samples.length,faceFrames:samples.filter((a:any)=>a.faces?.length).length,faceCounts:samples.map((a:any)=>a.faces?.length||0),bodyFrames:samples.filter((a:any)=>a.persons?.length).length,trackIDs:ids.size,eligibleIDs:eligible.length,crowd:S.isCrowdScene(samples),kind:s.kind,split:!!s.split,window:[s.windowW,s.windowH],reason:s.uncertainty||s.contextStatus||'measured subject'};});
const summary={shots:rows.length,sampleCount:t.raw_samples.length,conversationSplitDeclared:m.conversation_split_candidate===true,unanchored:rows.filter(r=>!r.eligibleIDs).length,noFaces:rows.filter(r=>!r.faceFrames).length,crowd:rows.filter(r=>r.crowd).length,shortUnder1_5:rows.filter(r=>r.seconds<1.5).length,results:rows};fs.writeFileSync('/downloads/vireo-autolayout-eval/beast-decision-trace.json',JSON.stringify(summary,null,2));console.log(JSON.stringify({...summary,results:rows.map(({faceCounts,...r})=>r)},null,2));
