import fs from 'node:fs';import cp from 'node:child_process';Object.assign(process.env,{MONGODB_URI:'mongodb://127.0.0.1:27019',MONGODB_DB_NAME:'vireo_recovery_qualification'});const {getMongoDb,closeMongo}=await import('../../src/db/mongoClient.js');const {ProEditorService:P}=await import('../../src/services/proEditorService.js');const f=JSON.parse(fs.readFileSync('/tmp/vireo-local-restore/studio-full-auto-fixture.json','utf8'));const db=await getMongoDb();const p=await db.collection('editor_projects').findOne({id:f.editor_id}),track=await db.collection('reframe_tracks').findOne({clip_id:f.clip_id});const source=process.argv[2]||'/downloads/recovered-source/cottonbro-studio-12s.mp4';const g=P.compileRenderGraph(p as any,source,'/tmp/studio-debug.mp4','/tmp',{aspectRatio:'9:16',mode:'smart',layoutMode:'track',track,clipStartSec:0,canvasScale:2/3} as any,'off');fs.writeFileSync('/tmp/studio-debug-graph.json',JSON.stringify(g));const out=cp.spawnSync('/usr/bin/ffmpeg',['-v','error','-filter_complex_threads','1',...g.inputArgs,'-filter_complex',g.filterComplex.join(';'),'-map',g.videoMap,'-map',g.audioMap,'-t','12','-c:v','libx264','-threads','1','-preset','ultrafast','-y','/tmp/studio-debug.mp4'],{encoding:'utf8',timeout:20000});console.log('STATUS',out.status,out.stderr);await closeMongo();
