import fs from 'node:fs';import {execFileSync} from 'node:child_process';import ffmpeg from 'ffmpeg-static';import {SmartReframeService as S} from '../../src/services/smartReframeService.js';import {presentFit43} from '../../src/shared/automaticLayoutPolicy.js';
const a={start:0,end:4,kind:'solo' as const,windowW:.3,windowH:.8,keyframes:[{time:0,centerX:.45,centerY:.5}]};
const old={...a,windowH:.3*640/(4/3*360)};const now=presentFit43([a],640,360)[0];fs.writeFileSync('/downloads/vireo-autolayout-eval/fit43-expand-geometry.json',JSON.stringify({measured:a,old,now},null,2));
// A diagnostic target, not a claim of automatic detection on natural footage.
execFileSync(ffmpeg!,['-y','-v','error','-threads','1','-f','lavfi','-i',"color=c=0x252525:s=640x360:r=25:d=4,drawbox=x=192:y=36:w=192:h=288:c=green:t=fill,drawbox=x=192:y=36:w=192:h=5:c=yellow:t=fill,drawbox=x=192:y=319:w=192:h=5:c=red:t=fill,drawbox=x=283:y=36:w=10:h=288:c=white:t=fill",'-c:v','libx264','-threads','1','-preset','ultrafast','/downloads/vireo-autolayout-eval/fit43-diagnostic-source.mp4']);
for(const [tag,plan] of [['before',old],['after',now]] as const){const f=S.buildShotCompositionFilter({plan:[plan] as any,duration:4,sourceWidth:640,sourceHeight:360,canvasScale:2/3});execFileSync(ffmpeg!,['-y','-v','error','-filter_complex_threads','1','-threads','1','-i','/downloads/vireo-autolayout-eval/fit43-diagnostic-source.mp4','-filter_complex',f,'-map','[out]','-c:v','libx264','-threads','1','-preset','ultrafast',`/downloads/vireo-autolayout-eval/fit43-expand-${tag}.mp4`]);}
