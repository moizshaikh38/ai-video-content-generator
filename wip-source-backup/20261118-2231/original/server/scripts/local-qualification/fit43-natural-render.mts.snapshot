import fs from 'node:fs';import {execFileSync} from 'node:child_process';import ffmpeg from 'ffmpeg-static';import {SmartReframeService as S} from '../../src/services/smartReframeService.js';
const p=JSON.parse(fs.readFileSync('/downloads/vireo-autolayout-eval/fit43-natural-ablation.json','utf8')).find((p:any)=>p.name==='mixed');
for(const tag of ['before','after']){const f=S.buildShotCompositionFilter({plan:p[tag],duration:12,sourceWidth:p.sourceWidth,sourceHeight:p.sourceHeight,canvasScale:2/3});execFileSync(ffmpeg!,['-y','-v','error','-filter_complex_threads','1','-threads','1','-i','/downloads/recovered-source/mixed-framing-36s.mp4','-filter_complex',f,'-map','[out]','-an','-c:v','libx264','-threads','1','-preset','ultrafast','-crf','22',`/downloads/vireo-autolayout-eval/fit43-natural-walk-${tag}-12s.mp4`],{timeout:40000});}
