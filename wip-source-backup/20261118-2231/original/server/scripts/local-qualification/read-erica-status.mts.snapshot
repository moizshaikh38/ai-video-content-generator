import fs from'node:fs';import{MongoClient}from'mongodb';const c=new MongoClient('mongodb://127.0.0.1:27019');await c.connect();try{const db=c.db('vireo_recovery_qualification');const clip=await db.collection('clips').findOne({id:'6536021e-7159-4fa8-9f4a-9d833206053e'});const names=(await db.listCollections().toArray()).map(x=>x.name).filter(x=>x.includes('reframe'));const tracks=[];for(const name of names)tracks.push({collection:name,records:await db.collection(name).find({clip_id:'6536021e-7159-4fa8-9f4a-9d833206053e'}).toArray()});const out={scope:'read-only status after interrupted once-only execution; no retry',clip,tracks};fs.writeFileSync('/downloads/vireo-blind-baseline/erica-persisted-status.json',JSON.stringify(out,null,2));console.log(JSON.stringify({clip_status:clip?.render_status,tracks:tracks.map(x=>({collection:x.collection,records:x.records.map(r=>({status:r.status,error:r.error_message}))}))}));}finally{await c.close()}
