import{test}from'node:test';import assert from'node:assert/strict';
import{ShotEvidenceReviewService as S,type EvidencePackage}from'../services/shotEvidenceReviewService.js';
const pkg:EvidencePackage={version:'source-shot-evidence-v1',sourceSHA256:'abc',shots:[{id:'s',start:0,end:1,frames:[{id:'s-f0',time:.1,sha256:'a',path:'/unused',width:854,height:480}]}],audioSupplied:false,transcriptSupplied:false,continuousCoverage:false};
const response=(importance='unknown')=>({shots:[{shotId:'s',entities:[{id:'p',kind:'person',importance,observations:[{frameId:'s-f0',box:{x:.8,y:.1,width:.15,height:.5},visibleFact:'A partial person is visible at the right edge.'}],uncertainty:['Role is unknown.']}],unknowns:['No audio supplied.']}]});
test('unknown and model-optional never become permission to crop',()=>{for(const importance of['unknown','optional','required']){const [r]=S.validate(pkg,response(importance));assert.equal(r.entities[0].protection,'preserve');assert.equal(r.automaticApply,false);const review=S.reviewCrop(r,{x:0,y:0,width:.7,height:1});assert.equal(review.status,'blocked-visible-loss');assert.equal(review.losses[0].permissionToDrop,false)}});
test('in-frame evidence is review only, not continuous clearance',()=>{const[r]=S.validate(pkg,response());assert.equal(S.reviewCrop(r,{x:0,y:0,width:1,height:1}).status,'review-only-no-continuous-clearance')});
test('fabricated frame, out-of-source box, duplicate and missing shots rejected',()=>{const a=response();a.shots[0].entities[0].observations[0].frameId='invented';assert.throws(()=>S.validate(pkg,a));const b=response();b.shots[0].entities[0].observations[0].box.x=.99;assert.throws(()=>S.validate(pkg,b));const c=response();c.shots.push(c.shots[0]);assert.throws(()=>S.validate(pkg,c));assert.throws(()=>S.validate(pkg,{shots:[]}))});
test('entity labels cannot claim a new optionality authority',()=>{const a=response('optional');const[r]=S.validate(pkg,a);assert.equal(r.entities[0].importanceAuthority,'model-assessment-only');a.shots[0].entities[0].observations[0].box.x=0;assert.equal(r.entities[0].observations[0].box.x,.8)});
