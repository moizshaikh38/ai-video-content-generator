import fs from'node:fs';import{SmartReframeService as S}from'../../src/services/smartReframeService.js';import{movingBodyPortraitProposal as B}from'../../src/shared/movingBodyPortraitProposal.js';
const t=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));const a=t.raw_samples.filter((s:any)=>s.time<12);console.log('dims',t.source_width,t.source_height,'n',a.length,'body',B(a,0,12,t.source_width,t.source_height,t.metadata.protected_content_regions));console.log('plan',S.explicitAutoLayoutPlan(t,{layout_mode_source:'auto'},24)?.map(s=>({start:s.start,end:s.end,kind:s.kind,windowW:s.windowW})));console.log('persons',a.map((s:any)=>({t:s.time,p:s.persons})));
