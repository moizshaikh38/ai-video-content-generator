/** OFFLINE DIAGNOSTIC ONLY: supplied dense pixel evidence, not ordinary Auto. */
import fs from'node:fs';import{execFileSync as exec}from'node:child_process';import{SmartReframeService as S}from'../../src/services/smartReframeService.js';
const track=JSON.parse(fs.readFileSync('/downloads/vireo-montage-auto-job-1152/fresh-normal-track.json','utf8')),e=JSON.parse(fs.readFileSync('/downloads/vireo-montage-active-strict-1155.json','utf8')),sensitivity=JSON.parse(fs.readFileSync('/downloads/vireo-black-space-sensitivity-1215.json','utf8')),cuts=[0,...track.metadata.scene_cuts,12.012];const plan=cuts.slice(0,-1).map((a,n)=>{const b=cuts[n+1],rows=[sensitivity.thresholdBounds['0'][n]];const x=Math.max(0,Math.min(...rows.map((v:any)=>v[0]))-12),y=Math.max(0,Math.min(...rows.map((v:any)=>v[1]))-12),right=Math.min(960,Math.max(...rows.map((v:any)=>v[2]))+12),bottom=Math.min(540,Math.max(...rows.map((v:any)=>v[3]))+12);return{start:a,end:b,kind:'fit' as const,windowW:(right-x)/960,windowH:(bottom-y)/540,keyframes:[{time:a,centerX:(x+right)/1920,centerY:(y+bottom)/1080}]};});
const graph=S.buildShotCompositionFilter({plan,start:0,duration:12.012,sourceWidth:960,sourceHeight:540,canvasScale:2/3,tag:'montageproof'});fs.writeFileSync('/downloads/vireo-montage-offline-proposal-1216.json',JSON.stringify({offlineOnly:true,threshold0:true,denseFrames:288,paddingSourcePixels:12,notSemanticSafety:true,plan},null,2));
exec('ffmpeg',['-v','error','-y','-threads','1','-filter_complex_threads','1','-i',e.source,'-filter_complex',`[0:v]${graph}[v]`,'-map','[v]','-an','-t','12.012','-c:v','libx264','-preset','ultrafast','-crf','23','/downloads/vireo-montage-offline-proposal-1216.mp4']);
