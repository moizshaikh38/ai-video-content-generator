const fs=require('fs'),path=require('path'),cp=require('child_process'),assert=require('assert/strict'),pp=require('/tmp/vireo-local-restore/ui-driver/node_modules/puppeteer-core');
const out=process.argv[2],base=path.resolve(__dirname,'../../..'),fixture=path.join(base,'public/audit-item-plan');assert(!fs.existsSync(fixture));fs.mkdirSync(fixture);fs.copyFileSync(path.join(out,'fixture.json'),path.join(fixture,'fixture.json'));
const fd=fs.openSync(path.join(out,'controls-vite.log'),'w'),server=cp.spawn(path.join(base,'node_modules/.bin/vite'),['--host','127.0.0.1','--port','5211','--strictPort'],{cwd:base,stdio:['ignore',fd,fd]});const sleep=n=>new Promise(r=>setTimeout(r,n));
(async()=>{let browser;const errors=[],calls=[],states=[];try{
 for(let n=0;n<100;n++){try{if((await fetch('http://127.0.0.1:5211/harness-item-plan.html')).ok)break;}catch{}await sleep(100)}
 browser=await pp.launch({executablePath:'/usr/bin/google-chrome',headless:true,args:['--no-sandbox','--disable-dev-shm-usage','--disable-features=MediaRouter'],defaultViewport:{width:1440,height:1100,deviceScaleFactor:1}});const page=await browser.newPage();page.on('pageerror',e=>errors.push(e.message));page.on('response',r=>{if(r.url().includes('/qualification/reframe'))calls.push({url:r.url(),status:r.status()})});await page.setRequestInterception(true);page.on('request',r=>new URL(r.url()).hostname==='127.0.0.1'&&r.method()==='GET'?r.continue():r.abort());await page.goto('http://127.0.0.1:5211/harness-item-plan.html',{waitUntil:'domcontentloaded',timeout:60000});await page.waitForSelector('[data-testid="preview-layout-canvas"]');await page.waitForFunction(()=>[...document.querySelectorAll('video')].some(v=>v.readyState>=2));await page.waitForSelector('[data-testid="auto-reframe-toggle"]');
 fs.writeFileSync(path.join(out,'controls-inventory.json'),JSON.stringify(await page.evaluate(()=>[...document.querySelectorAll('button')].map(b=>({text:b.innerText,title:b.title,testid:b.dataset.testid,disabled:b.disabled}))),null,2));
 const clickText=async(text,selector='button')=>{const h=await page.evaluateHandle((text,selector)=>[...document.querySelectorAll(selector)].find(e=>e.textContent.trim()===text),text,selector);assert(await h.asElement(),'Missing control '+text);await h.asElement().click();await h.dispose();};
 const seek=async t=>{const r=await page.$('[aria-label="Timeline ruler"], .h-7.sticky.top-0.cursor-pointer'),b=await r.boundingBox(),z=await page.$eval('[aria-label="Timeline Zoom"]',e=>Number(e.value));await page.mouse.click(b.x+48+t*z,b.y+12);await page.waitForFunction(t=>Math.abs(window.itemPlanProject.playhead-t)<.05&&!document.querySelector('video').seeking,{},t);await page.evaluate(()=>new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r))));};
 const capture=async(name)=>{await page.keyboard.press('Escape');for(const t of [0]){await (await page.$('[data-testid="preview-layout-canvas"]')).screenshot({path:path.join(out,name+'-preview-'+t+'.png')});}await page.screenshot({path:path.join(out,name+'-desktop.png')});const p=await page.evaluate(()=>window.itemPlanProject);fs.writeFileSync(path.join(out,name+'-project.json'),JSON.stringify(p,null,2));states.push({name,project:p,text:await page.evaluate(()=>document.body.innerText)});};
 await clickText('Background');await clickText('Blur');await page.keyboard.press('Escape');await sleep(500);await capture('background-blur');
 fs.writeFileSync(path.join(out,'backdrop-dom.json'),JSON.stringify(await page.evaluate(()=>[...document.querySelectorAll('[data-testid="preview-layout-canvas"] canvas')].map(c=>({width:c.width,height:c.height,style:c.getAttribute('style'),bounds:c.getBoundingClientRect().toJSON(),filter:getComputedStyle(c).filter,time:c.dataset.mirroredMediaTime}))),null,2));
 const canvas=await page.$('[data-testid="preview-layout-canvas"] canvas');assert(canvas);
 for(const sigma of [3,6,9,11,15]){await canvas.evaluate((c,sigma)=>c.style.filter=c.style.filter.replace(/blur\([^)]*\)/,'blur('+sigma+'px)'),sigma);await sleep(100);await (await page.$('[data-testid="preview-layout-canvas"]')).screenshot({path:path.join(out,'blur-sigma-'+sigma+'.png')});}
 assert.deepEqual(errors,[]);assert(calls.length>0&&calls.every(c=>c.status===200));fs.writeFileSync(path.join(out,'controls-browser.json'),JSON.stringify({states,calls,errors,actualUIControls:true,externalRequestsForbidden:true},null,2));console.log('ACTUAL_BRANCH_CONTROLS_CAPTURED',states.length);
 }finally{if(browser)await browser.close();server.kill('SIGTERM');fs.closeSync(fd);fs.rmSync(fixture,{recursive:true,force:true});}})().catch(e=>{console.error(e);process.exitCode=1});
