import fs from'node:fs';import{SmartReframeService as S}from'../../src/services/smartReframeService.js';import{boundedCameraPath}from'../../src/shared/boundedCameraPath.js';
for(const file of ['/downloads/vireo-shortauto-walk-job-0845/fresh-normal-track.json','/downloads/vireo-freeze-mixed-job-0907/fresh-normal-track.json']){const t=JSON.parse(fs.readFileSync(file,'utf8'));const p=S.explicitAutoLayoutPlan(t,{layout_mode_source:'auto'},t.metadata.clip_duration)!;for(const s of p.filter(v=>v.kind==='solo'))console.log(file,s.keyframes.length,boundedCameraPath(s.keyframes)?.length);}
