import fs from'node:fs';import{execFileSync}from'node:child_process';import{SmartReframeService as S}from'../../src/services/smartReframeService.js';import ffmpeg from'ffmpeg-static';
const source=process.argv[2];const duration=12*1001/30000,cut=.333666;const plan=[{start:0,end:cut,kind:'fit',windowW:.75,windowH:1,keyframes:[{time:0,centerX:.5,centerY:.5}]},{start:cut,end:duration,kind:'fit',windowW:.75,windowH:1,keyframes:[{time:cut,centerX:.5,centerY:.5}]}]as any;const fixed=S.buildShotCompositionFilter({plan,duration,sourceWidth:64,sourceHeight:36,canvasScale:.1});
const old=fixed.replaceAll('fps=30:eof_action=pass','fps=30').replace('concat=n=2:v=1:a=0,settb=1/30,setpts=N,','concat=n=2:v=1:a=0,');
for(const[name,f]of[['old',old],['fixed',fixed]]){const b=execFileSync(ffmpeg!,['-v','error','-filter_complex_threads','1','-i',source,'-filter_complex',f+';[out]fps=30,scale=8:8,format=rgb24[check]','-map','[check]','-f','rawvideo','-threads','1','-']);console.log(name,b.length/192,[10,11].map(n=>b.subarray(n*192,(n+1)*192).reduce((a,v)=>a+v,0)/192));}
