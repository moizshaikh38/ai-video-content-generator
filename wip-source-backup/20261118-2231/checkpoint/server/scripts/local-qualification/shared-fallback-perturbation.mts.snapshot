import fs from'node:fs';import{SmartReframeService as S}from'../../src/services/smartReframeService.js';import{legacyFit43Plan}from'../../src/shared/automaticLayoutPolicy.js';
const t=JSON.parse(fs.readFileSync('/downloads/vireo-auto-text-pair-ui-1448/fresh-normal-track.json','utf8')),d=t.metadata.clip_duration;
for(const variant of ['baseline','mouth-alternates','mouth-absent','body-absent','second-face-intermittent']){const x=structuredClone(t);x.raw_samples=x.raw_samples.map((s:any,i:number)=>({...s,persons:variant==='body-absent'?[]:s.persons,faces:s.faces.filter((f:any,j:number)=>variant!=='second-face-intermittent'||j===0||i%4!==0).map((f:any,j:number)=>({...f,mouth_score:variant==='mouth-absent'?undefined:variant==='mouth-alternates'?Number(i%2===j):f.mouth_score}))}));const explicit=S.explicitAutoLayoutPlan(x,{layout_mode_source:'auto'},d);const group=S.computeGroupFrameGeometry({rawSamples:x.raw_samples,sourceWidth:x.source_width,sourceHeight:x.source_height});const plan=explicit||legacyFit43Plan(x,d,group,S.isLowConfidenceTrack(x));console.log(JSON.stringify({variant,explicit:!!explicit,group:!!group,plan,faces:x.raw_samples.map((s:any)=>s.faces)}));}
