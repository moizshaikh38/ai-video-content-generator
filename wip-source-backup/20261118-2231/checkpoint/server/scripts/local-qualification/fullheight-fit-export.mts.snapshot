import fs from'node:fs';import{execFileSync as run}from'node:child_process';import{SmartReframeService as N}from'../../src/services/smartReframeService.js';import{SmartReframeService as O}from'/tmp/vireo-backup-0632/server/src/services/smartReframeService.js';
const out='/downloads/vireo-fullheight-synthetic-0813';fs.mkdirSync(out,{recursive:true});
const raw=Array.from({length:16},(_,i)=>({time:i/4,faces:[{track_id:'one',x:.475,y:.29,width:.05,height:.1,center_x:.5,center_y:.34,confidence:.95}],persons:[{x:.45,y:.28,width:.1,height:.65,confidence:.95}],objects:[{class_id:8,x:.05,y:.55,width:.18,height:.2,confidence:.9}]}));const o={rawSamples:raw,duration:4,sourceWidth:854,sourceHeight:480,windowScope:'shot' as const,automaticFitAspect:'4:3' as const};
run('ffmpeg',['-v','error','-y','-f','lavfi','-i','color=c=0x202838:s=854x480:r=30:d=4','-vf','drawgrid=w=85:h=48:t=1:c=white@0.15,drawbox=x=384:y=134:w=86:h=312:c=green:t=fill,drawbox=x=406:y=139:w=43:h=48:c=yellow:t=fill,drawbox=x=43:y=264:w=154:h=96:c=red:t=fill,drawbox=x=0:y=0:w=16:h=480:c=blue:t=fill,drawbox=x=838:y=0:w=16:h=480:c=magenta:t=fill','-c:v','libx264','-threads','1','-preset','ultrafast',out+'/source.mp4']);
for(const [name,S]of[['before',O],['candidate',N]]as const){const plan=S.computeShotComposition(o);fs.writeFileSync(out+'/'+name+'-plan.json',JSON.stringify(plan,null,2));const graph=N.buildShotCompositionFilter({plan,sourceWidth:854,sourceHeight:480,duration:4,canvasScale:1/3});run('ffmpeg',['-v','error','-y','-i',out+'/source.mp4','-filter_complex_threads','1','-filter_complex',graph,'-map','[out]','-an','-c:v','libx264','-threads','1','-preset','ultrafast',out+'/'+name+'.mp4']);}
run('ffmpeg',['-v','error','-y','-i',out+'/before.mp4','-i',out+'/candidate.mp4','-filter_complex','[0:v]drawtext=text=BEFORE:x=8:y=8:fontcolor=white:fontsize=18[a];[1:v]drawtext=text=CANDIDATE:x=8:y=8:fontcolor=white:fontsize=18[b];[a][b]hstack=inputs=2[v]','-map','[v]','-an','-c:v','libx264','-threads','1','-preset','ultrafast',out+'/comparison.mp4']);console.log(out);
