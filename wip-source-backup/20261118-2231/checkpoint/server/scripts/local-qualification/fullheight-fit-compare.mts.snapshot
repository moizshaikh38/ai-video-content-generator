import fs from'node:fs';import{SmartReframeService as N}from'../../src/services/smartReframeService.js';import{SmartReframeService as O}from'/tmp/vireo-backup-0632/server/src/services/smartReframeService.js';
const dirs=fs.readdirSync('/downloads').filter(n=>n.startsWith('vireo-'));let count=0;
for(const d of dirs){const p='/downloads/'+d+'/fresh-normal-track.json';if(!fs.existsSync(p))continue;const t=JSON.parse(fs.readFileSync(p,'utf8'));const o={rawSamples:t.raw_samples,sceneCuts:t.metadata.scene_cuts,duration:t.metadata.clip_duration,sourceWidth:t.source_width,sourceHeight:t.source_height,windowScope:'shot' as const,automaticFitAspect:'4:3' as const,protectedContentRegions:t.metadata.protected_content_regions};if(!o.duration)continue;count++;const a=O.computeShotComposition(o),b=N.computeShotComposition(o);if(JSON.stringify(a)!==JSON.stringify(b))console.log(d,JSON.stringify({old:a.map(s=>({start:s.start,w:s.windowW,h:s.windowH})),next:b.map(s=>({start:s.start,w:s.windowW,h:s.windowH}))}));}console.log('checked',count);
