import fs from'node:fs';import{ProEditorService as P}from'../../src/services/proEditorService.js';import{SmartReframeService as S}from'../../src/services/smartReframeService.js';import{captionCompositionWindows as W,applySceneCaptionPlacement as place}from'../../src/shared/sceneCaptionPlacement.js';
const root='/downloads/vireo-bounded-mixed-job-1051',project=JSON.parse(fs.readFileSync(root+'/layout-auto-saved-project.json','utf8')),track=JSON.parse(fs.readFileSync(root+'/fresh-normal-track.json','utf8'));const v=project.tracks.find((t:any)=>t.type==='VIDEO').items[0];const plan=S.explicitAutoLayoutPlan(track,v.crop_config,24)!;const preview=W(project,plan,0,track.source_width,track.source_height);const exported=P.captionSceneWindows(project,{mode:'smart',layoutMode:'track',track,clipStartSec:0,cropConfig:v.crop_config} as any);const cue={start:13,end:14,text:'LAYOUT CHECK'};console.log(JSON.stringify({previewWindows:preview,exportWindows:exported,previewCaption:place([cue],{project,automaticWindows:preview}),exportCaption:place([cue],{project,automaticWindows:exported})},null,2));
