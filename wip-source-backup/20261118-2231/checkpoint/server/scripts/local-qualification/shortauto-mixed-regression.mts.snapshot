import fs from'node:fs';import assert from'node:assert/strict';
Object.assign(process.env,{NODE_ENV:'test',MONGODB_URI:'mongodb://127.0.0.1:27020/?replicaSet=homeproof',SUPABASE_URL:'http://127.0.0.1:5998',SUPABASE_SECRET_KEY:'local-fixture',R2_ACCOUNT_ID:'localfixture',R2_ACCESS_KEY_ID:'localfixture',R2_SECRET_ACCESS_KEY:'localfixture',R2_ENDPOINT:'http://127.0.0.1:5588',R2_SOURCE_BUCKET:'source',R2_CLIPS_BUCKET:'clips',OPENROUTER_API_KEY:'',PYTHON_PATH:'/tmp/vireo-local-restore/cv-env/bin/python',SMART_REFRAME_YUNET_MODEL:'/tmp/vireo-local-restore/models/yunet.onnx',SMART_REFRAME_YUNET_THRESHOLD:'.85',SMART_REFRAME_PERSON_MODEL:'/tmp/vireo-local-restore/models/nanodet.onnx',SMART_REFRAME_HSV_CUTS:'1'});
const{SmartReframeService:S}=await import('../../src/services/smartReframeService.js');
for(const[name,file,expected]of[['body-pair','mixed-body-pair-24s-0756.mp4','solo'],['missing-body','mixed-diverse-24s-0651.mp4','fit']]as const){
 const r=JSON.parse(fs.readFileSync('/downloads/vireo-shortauto-'+name+'-0849.json','utf8')).cv;S.associateTracks(r.samples,.35,r.scene_cuts);const track:any={status:'ready',source_width:r.source_width,source_height:r.source_height,metadata:{analyzed_source_sha256:'b'.repeat(64),scene_cuts:r.scene_cuts,protected_content_regions:r.protected_content_regions},raw_samples:r.samples};const p=S.explicitAutoLayoutPlan(track,{layout_mode_source:'auto'},24)!;assert.equal(p[0].kind,expected);if(name==='body-pair')assert.ok(p[1].split);else assert.ok(p.every(s=>s.kind==='fit'));fs.writeFileSync('/downloads/vireo-shortauto-'+name+'-0849.json',JSON.stringify({cv:r,plan:p},null,2));console.log(name,r.scene_cuts,r.scene_cut_discovery,p.map(s=>({start:s.start,end:s.end,kind:s.kind,split:!!s.split})));
}
