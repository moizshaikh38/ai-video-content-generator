import fs from'node:fs';import path from'node:path';import{SmartReframeService as S}from'../../src/services/smartReframeService.js';import{legacyFit43Plan}from'../../src/shared/automaticLayoutPolicy.js';
const seen=new Set();for(const dir of fs.readdirSync('/downloads')){const file=path.join('/downloads',dir,'fresh-normal-track.json');if(!fs.existsSync(file))continue;let t:any;try{t=JSON.parse(fs.readFileSync(file,'utf8'))}catch{continue}const sha=t.metadata?.analyzed_source_sha256;if(!sha||seen.has(sha)||!t.raw_samples?.length||t.metadata?.shot_composition_candidate===true)continue;seen.add(sha);const duration=t.metadata.clip_duration||t.smoothed_keyframes?.at(-1)?.time;const plan=S.explicitAutoLayoutPlan(t,{layout_mode_source:'auto'},duration)||legacyFit43Plan(t,duration,S.computeGroupFrameGeometry({rawSamples:t.raw_samples,sourceWidth:t.source_width,sourceHeight:t.source_height}),S.isLowConfidenceTrack(t));if(!plan)continue;let faces=0,lost=0,multiRows=0;const counts=new Map();for(const row of t.raw_samples)for(const f of row.faces)if(f.track_id&&f.confidence>=.8)counts.set(f.track_id,(counts.get(f.track_id)||0)+1);for(const row of t.raw_samples){const p=plan.find(p=>row.time>=p.start&&row.time<p.end);if(!p||p.split)continue;const positive=row.faces.filter(f=>f.track_id&&f.confidence>=.8&&(counts.get(f.track_id)||0)>=Math.max(3,t.raw_samples.length*.35));if(positive.length>=2)multiRows++;for(const f of positive){faces++;const k=p.keyframes.reduce((a,b)=>Math.abs(a.time-row.time)<Math.abs(b.time-row.time)?a:b);if(f.x<k.centerX-p.windowW/2-1e-6||f.x+f.width>k.centerX+p.windowW/2+1e-6||f.y<k.centerY-p.windowH/2-1e-6||f.y+f.height>k.centerY+p.windowH/2+1e-6)lost++;}}
if(multiRows)console.log(JSON.stringify({file,sha,policy:t.metadata?.content_framing_decision,faces,lost,multiRows,plan}));}
