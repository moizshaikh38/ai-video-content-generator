import sys,json,cv2
sys.path.insert(0,'python')
from person_regions import PersonRegions
p=PersonRegions('/tmp/vireo-local-restore/models/nanodet.onnx');cap=cv2.VideoCapture('/downloads/recovered-source/mixed-diverse-24s-0651.mp4');out=[]
for t in [7.4,7.68,7.95,10.77,11.04,11.31]:
 cap.set(cv2.CAP_PROP_POS_MSEC,t*1000);ok,frame=cap.read()
 if not ok:raise Exception('frame read failed')
 p.model.prob_threshold=.4;a,objs=p.infer_with_context(frame)
 p.model.prob_threshold=.1;b,lowobjs=p.infer_with_context(frame)
 cv2.imwrite('/downloads/vireo-missingbody-'+str(t)+'.png',frame)
 out.append({'time':t,'normalPersons':a,'normalStrongObjects':objs,'diagnosticLowScorePersonsNotForUse':b})
print(json.dumps(out,indent=2));json.dump(out,open('/downloads/vireo-body-missing-diagnostic-0820.json','w'),indent=2)
