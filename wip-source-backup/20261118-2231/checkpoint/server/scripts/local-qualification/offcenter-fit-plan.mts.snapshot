import fs from'node:fs';import{SmartReframeService as S}from'../../src/services/smartReframeService.js';import{constrainedFit43 as fit}from'../../src/shared/constrainedFit43.js';
const t=JSON.parse(fs.readFileSync('/downloads/vireo-offcenter-fit-old-job-1104/fresh-normal-track.json','utf8'));const p=S.explicitAutoLayoutPlan(t,{layout_mode_source:'auto'},12)!;console.log('cuts',t.metadata.scene_cuts);for(const s of p){const rows=t.raw_samples.filter((r:any)=>r.time>=s.start&&r.time<s.end);console.log(s.start,s.end,s.windowW,s.keyframes[0],rows.length,fit(rows,[],t.source_width,t.source_height));}
