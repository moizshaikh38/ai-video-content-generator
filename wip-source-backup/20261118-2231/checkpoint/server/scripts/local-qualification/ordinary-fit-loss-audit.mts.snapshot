import fs from'node:fs';import{execFileSync}from'node:child_process';import{SmartReframeService as S}from'../../src/services/smartReframeService.js';
const files=execFileSync('find',['/downloads','-maxdepth','2','-name','fresh-normal-track.json'],{encoding:'utf8'}).trim().split('\n');const seen=new Set(),out=[];
for(const file of files){const t=JSON.parse(fs.readFileSync(file,'utf8'));const hash=t.metadata?.analyzed_source_sha256;if(!hash||seen.has(hash))continue;seen.add(hash);const duration=t.metadata?.clip_duration||Math.max(...t.raw_samples.map((s:any)=>s.time))+.25;const plan=S.explicitAutoLayoutPlan(t,{layout_mode_source:'auto'},duration);if(!plan)continue;for(const shot of plan){if(shot.split)continue;const samples=t.raw_samples.filter((s:any)=>s.time>=shot.start&&s.time<shot.end),faces=samples.flatMap((s:any)=>s.faces.filter((f:any)=>f.confidence>=.8)),k=shot.keyframes[0];if(!k)continue;const lost=faces.filter((f:any)=>f.x<k.centerX-shot.windowW/2||f.x+f.width>k.centerX+shot.windowW/2);if(lost.length)out.push({file,start:shot.start,end:shot.end,kind:shot.kind,width:shot.windowW,height:shot.windowH,cx:k.centerX,faces:faces.length,lost:lost.length,minX:Math.min(...faces.map((f:any)=>f.x)),maxX:Math.max(...faces.map((f:any)=>f.x+f.width)),reason:shot.presentationProtection});}}
fs.writeFileSync('/downloads/vireo-ordinary-fit-loss-audit-1103.json',JSON.stringify(out,null,2));console.log(JSON.stringify({sources:seen.size,losses:out},null,2));
