/** Normal analyzer on a local real source, no transcript synthesis or provider. */
import fs from 'node:fs';import path from 'node:path';import http from 'node:http';import crypto from 'node:crypto';import assert from 'node:assert/strict';
const [source,out]=process.argv.slice(2);if(!source||!out||fs.existsSync(out))throw Error('Source and new output required');fs.mkdirSync(out,{recursive:true});
Object.assign(process.env,{NODE_ENV:'test',MONGODB_URI:'mongodb://127.0.0.1:27020/?replicaSet=homeproof',MONGODB_DB_NAME:'vireo_normal_source_cv',SUPABASE_URL:'http://127.0.0.1:5998',SUPABASE_SECRET_KEY:'local-fixture',R2_ACCOUNT_ID:'localfixture',R2_ACCESS_KEY_ID:'localfixture',R2_SECRET_ACCESS_KEY:'localfixture',R2_ENDPOINT:'http://127.0.0.1:5589',R2_SOURCE_BUCKET:'source',R2_CLIPS_BUCKET:'clips',OPENROUTER_API_KEY:'',GROQ_API_KEY:'',SMART_REFRAME_SHOT_COMPOSITION:'1',PYTHON_PATH:'/tmp/vireo-local-restore/cv-env/bin/python',SMART_REFRAME_YUNET_MODEL:'/tmp/vireo-local-restore/models/yunet.onnx',SMART_REFRAME_YUNET_THRESHOLD:'.85',SMART_REFRAME_PERSON_MODEL:'/tmp/vireo-local-restore/models/nanodet.onnx',SMART_REFRAME_HSV_CUTS:'1'});
const sha=()=>crypto.createHash('sha256').update(fs.readFileSync(source)).digest('hex'),digest=sha(),etag='"'+digest+'"',key='qualification/'+crypto.randomUUID()+'.mp4',user=crypto.randomUUID(),id=crypto.randomUUID(),project=crypto.randomUUID();
const server=http.createServer((req,res)=>{res.setHeader('Content-Length',fs.statSync(source).size);res.setHeader('ETag',etag);res.setHeader('Content-Type','video/mp4');if(req.method==='HEAD')res.end();else fs.createReadStream(source).pipe(res);});await new Promise<void>(r=>server.listen(5589,'127.0.0.1',r));
const {getMongoDb,closeMongo}=await import('../../src/db/mongoClient.js');const {ownerContext}=await import('../../src/db/repositories/dataRepository.js');const {downloadObjectToFile}=await import('../../src/services/objectStorageService.js');const {SmartReframeService}=await import('../../src/services/smartReframeService.js');const db=await getMongoDb();const start=Date.now();
try{const download=await downloadObjectToFile('source',key,path.join(out,'verified-source.mp4'),{requireSnapshotReceipt:true});assert.equal(download.sha256,digest);await db.collection('clips').insertOne({id,user_id:user,project_id:project,source_storage_path:key,start_seconds:0,end_seconds:12,aspect_ratio:'9:16',crop_config:{mode:'smart',layout_mode:'track',layout_mode_source:'auto'}});const track=await ownerContext.run(user,()=>SmartReframeService.analyzeClipFraming(id,user,{localSourcePath:path.join(out,'verified-source.mp4'),sourceReceipt:download.sourceReceipt}));assert.equal(track.status,'ready');assert.equal(sha(),digest);fs.writeFileSync(path.join(out,'track.json'),JSON.stringify(track,null,2));fs.writeFileSync(path.join(out,'stdout.json'),JSON.stringify({samples:track.raw_samples,source_width:track.source_width,source_height:track.source_height},null,2));fs.writeFileSync(path.join(out,'manifest.json'),JSON.stringify({source,sourceSha256:digest,sourceUnchanged:true,freshCvExecution:true,normalAnalyzerAssociation:true,providerCalls:0,samples:track.raw_samples.length,elapsedSeconds:(Date.now()-start)/1000},null,2));console.log('NORMAL_SOURCE_CV_PASS');}finally{await db.collection('clips').deleteMany({user_id:user});await db.collection('reframe_tracks').deleteMany({user_id:user});await closeMongo();await new Promise<void>(r=>server.close(()=>r()));}
