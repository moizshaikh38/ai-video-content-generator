/** Measured detector-sample retention, not independent person recognition. */
import fs from'node:fs';import{panelSourceWindow,panelTargetRects}from'../../src/shared/panelLayouts.js';
const root=process.argv[2],track=JSON.parse(fs.readFileSync(root+'/fresh-normal-track.json','utf8')),project=JSON.parse(fs.readFileSync(root+'/'+(process.argv[3]||'layout-four-reloaded-project.json'),'utf8')),item=project.tracks.find((t:any)=>t.type==='VIDEO').items[0],panels=item.panels||item.scene_layout_overrides?.[0]?.patch?.panels;if(!panels||!['three','four'].includes(panels.layout))throw Error('Saved Three/Four project required');const targets=panelTargetRects(panels),windows=panels.slots.map((s:any,i:number)=>panelSourceWindow(s,track.source_width,track.source_height,targets[i].w/targets[i].h*9/16));const idSets=windows.map(()=>new Set<string>());let faces=0,retained=0,fragments=0;const failures:any[]=[];
for(const sample of track.raw_samples){const fs=sample.faces;windows.forEach((r:any,i:number)=>{const hits=fs.map((f:any)=>{const x=f.x*track.source_width,y=f.y*track.source_height,w=f.width*track.source_width,h=f.height*track.source_height;const intersect=Math.max(0,Math.min(x+w,r.x+r.w)-Math.max(x,r.x))*Math.max(0,Math.min(y+h,r.y+r.h)-Math.max(y,r.y));return{f,fraction:intersect/(w*h)};}).filter((v:any)=>v.fraction>1e-6);faces++;if(hits.length===1&&hits[0].fraction>=.999999){retained++;idSets[i].add(hits[0].f.track_id);}else{fragments+=hits.filter((v:any)=>v.fraction<.999999).length;failures.push({time:sample.time,panel:i,hits:hits.map((h:any)=>({id:h.f.track_id,fraction:h.fraction}))});}});}
const report={caveat:'Same detector samples, not independent identity or every-frame/hair/full-body proof. Pixel crop rounding uses actual shared panelSourceWindow.',sampleCount:track.raw_samples.length,panelObservations:faces,fullyRetained:retained,foreignOrPartialFaceFragments:fragments,panelTrackIds:idSets.map((s:Set<string>)=>[...s]),windows,failures};fs.writeFileSync(root+'/render-retention-audit.json',JSON.stringify(report,null,2));console.log(JSON.stringify(report));
