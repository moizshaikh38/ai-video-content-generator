import{editorRenderSnapshot}from'../../src/shared/editorRenderSnapshot.js';
import{commitFencedRenderOutcome}from'../../src/services/queue/renderLeaseCommit.js';
const database='vireo_editor_revision_20261119_0042',uri='mongodb://127.0.0.1:27020/?replicaSet=homeproof';
assert.equal(new URL(uri).hostname,'127.0.0.1');const client=new MongoClient(uri,{serverSelectionTimeoutMS:3000,maxPoolSize:4});const checks:any[]=[];
const record=(name:string)=>checks.push({name,passed:true});
try{
 await client.connect();const db=client.db(database);assert.equal((await db.listCollections().toArray()).length,0,'Never reuse an existing DB');assert.equal((await db.admin().command({hello:1})).setName,'homeproof');
 const seed=async(project=true)=>{const id={jobId:crypto.randomUUID(),clipId:crypto.randomUUID(),userId:crypto.randomUUID(),workerId:'isolated-worker',renderVersion:1,editorVersion:1};const p={id:crypto.randomUUID(),clip_id:id.clipId,user_id:id.userId,version:1,canvas:{aspect_ratio:'9:16'},tracks:[],settings:{},title:'fixture'};await db.collection('clips').insertOne({id:id.clipId,user_id:id.userId,editor_version:1,render_version:1,render_status:'rendering'});await db.collection('render_jobs').insertOne({id:id.jobId,clip_id:id.clipId,user_id:id.userId,worker_id:id.workerId,status:'processing'});if(project)await db.collection('editor_projects').insertOne(p);return{id,p};};
 const save=(p:any,version=1,updates:any={title:'saved'})=>saveEditorRevision(client,db,{id:p.id,userId:p.user_id,expectedVersion:version,updates});
 const done={job:{status:'completed',worker_id:null},clip:{render_status:'ready'}};
 let {id,p}=await seed();let saved=await save(p,1,{title:'server-owned',version:500});assert.equal(saved?.version,2);let clip=await db.collection('clips').findOne({id:id.clipId});assert.deepEqual(clip?.editor_project_sync_pending,{id:p.id,version:2});assert.equal(clip?.editor_version,2);record('server owns next version and atomically marks Quick sync pending');
