 await assert.rejects(commitFencedRenderOutcome(client,db,{...id,editorVersion:2,editorProject:editorRenderSnapshot(saved)},done),{code:'RENDER_INPUT_CHANGED'});record('pending Pro/Quick projection cannot publish output');
 await syncClipEditorRevision(client,db,{clipId:id.clipId,userId:id.userId,expectedClipVersion:2,project:{id:p.id,version:2},payload:{editor_version:3,caption_style:'fixture'}});clip=await db.collection('clips').findOne({id:id.clipId});assert.equal(clip?.editor_project_sync_pending,null);record('matching Quick projection clears pending marker');
 await save(p,2);await assert.rejects(syncClipEditorRevision(client,db,{clipId:id.clipId,userId:id.userId,expectedClipVersion:4,project:{id:p.id,version:2},payload:{editor_version:5}}),{code:'EDITOR_REVISION_CONFLICT'});record('late older Quick sync cannot overwrite newer Pro revision');
 ({id,p}=await seed());const races=await Promise.allSettled([save(p),save(p)]);assert.equal(races.filter(x=>x.status==='fulfilled').length,1);assert.equal((await db.collection('editor_projects').findOne({id:p.id}))?.version,2);record('concurrent Pro saves have exactly one CAS winner');
 ({id,p}=await seed());const snap=editorRenderSnapshot(p);await db.collection('editor_projects').updateOne({id:p.id},{$set:{tracks:[{type:'TEXT',items:[]}]}});await assert.rejects(commitFencedRenderOutcome(client,db,{...id,editorProject:snap},done),{code:'RENDER_INPUT_CHANGED'});record('digest detects legacy same-version content mutation');
 ({id,p}=await seed());await commitFencedRenderOutcome(client,db,{...id,editorProject:editorRenderSnapshot(p)},done);assert.equal((await db.collection('editor_projects').findOne({id:p.id}))?.render_fence_serial,1);record('unchanged project publication writes same-document fence');
 // Pause real transaction after its project snapshot read, then save outside
 // that transaction. The subsequent fence must conflict and re-check, not
 // publish from the old Mongo snapshot (write-skew negative case).
 for(const firstCreate of[false,true]){
  ({id,p}=await seed(!firstCreate));let release!:()=>void,reached!:()=>void;const gate=new Promise<void>(r=>release=r),seen=new Promise<void>(r=>reached=r);let intercepted=false;
  const wrapper=new Proxy(db,{get(target,key){if(key==='collection')return(name:string)=>{const collection=target.collection(name);if(name!=='editor_projects')return collection;return new Proxy(collection,{get(c,k){if(k==='findOne')return async(...args:any[])=>{const row=await(c.findOne as any)(...args);if(!intercepted){intercepted=true;reached();await gate;}return row;};const v=(c as any)[k];return typeof v==='function'?v.bind(c):v;}});};const v=(target as any)[key];return typeof v==='function'?v.bind(target):v;}});
  const publishing=commitFencedRenderOutcome(client,wrapper,{...id,editorProject:firstCreate?null:editorRenderSnapshot(p)},done);await seen;if(firstCreate)await createEditorRevision(client,db,p);else await save(p);release();await assert.rejects(publishing,{code:'RENDER_INPUT_CHANGED'});assert.equal((await db.collection('render_jobs').findOne({id:id.jobId}))?.status,'processing');record(firstCreate?'first project creation during absent snapshot rejects stale publication':'save during actual snapshot transaction conflicts and rejects stale publication');
 }
 ({id,p}=await seed(false));const created=await Promise.all([createEditorRevision(client,db,{...p,id:crypto.randomUUID()}),createEditorRevision(client,db,{...p,id:crypto.randomUUID()})]);assert.equal(created[0].id,created[1].id);assert.equal(await db.collection('editor_projects').countDocuments({clip_id:id.clipId}),1);record('racing first initializations produce one retained editor project');
 ({id,p}=await seed());await assert.rejects(syncClipEditorRevision(client,db,{clipId:id.clipId,userId:crypto.randomUUID(),expectedClipVersion:1,project:{id:p.id,version:1},payload:{editor_version:2}}),{code:'EDITOR_REVISION_CONFLICT'});record('wrong owner cannot sync project or clip');
 ({id,p}=await seed());await saveEditorRevision(client,db,{id:p.id,userId:id.userId,expectedVersion:1,updates:{title:'internal-only'},requireClipSync:false});assert.equal((await db.collection('clips').findOne({id:id.clipId}))?.editor_project_sync_pending,null);record('server-only Pro operation needs no unrelated Quick projection');
 await save(p,2);await saveEditorRevision(client,db,{id:p.id,userId:id.userId,expectedVersion:3,updates:{title:'internal while pending'},requireClipSync:false});assert.deepEqual((await db.collection('clips').findOne({id:id.clipId}))?.editor_project_sync_pending,{id:p.id,version:4});record('server-only operation cannot erase an already pending browser projection');
 await assert.rejects(syncClipEditorRevision(client,db,{clipId:id.clipId,userId:id.userId,expectedClipVersion:4,project:{id:p.id,version:4},payload:{trim_start_offset:NaN}}),{code:'INVALID_NUMBER'});record('direct transaction path retains schema validation before writing clip settings');
 const result={database,loopbackOnly:true,checks,retainedDocuments:{jobs:await db.collection('render_jobs').countDocuments(),clips:await db.collection('clips').countDocuments(),editorProjects:await db.collection('editor_projects').countDocuments()},noMediaExternalStorageOrProductionAccess:true,ordinaryEndToEndNotProven:true};fs.mkdirSync('/downloads/vireo-editor-revision-0034',{recursive:true});fs.writeFileSync('/downloads/vireo-editor-revision-0034/real-mongo-result.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result,null,2));
}finally{await client.close();}
