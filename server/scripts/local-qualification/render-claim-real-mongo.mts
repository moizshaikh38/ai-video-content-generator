import assert from'node:assert/strict';import crypto from'node:crypto';import fs from'node:fs';import{MongoClient}from'mongodb';import{claimRenderLease}from'../../src/services/queue/renderLeaseClaim.js';
const client=new MongoClient('mongodb://127.0.0.1:27020/?replicaSet=homeproof',{maxPoolSize:2,serverSelectionTimeoutMS:3000});const checks:any[]=[];try{await client.connect();const db=client.db('vireo_render_retry_20261119_0015');assert.equal(await db.collection('render_jobs').countDocuments(),19,'Refuse unexpected/reused fixtures');const now=new Date();
 const seed=async(extra:any={})=>{const identity={jobId:crypto.randomUUID(),clipId:crypto.randomUUID(),userId:crypto.randomUUID(),workerId:'claim-worker',renderVersion:1,editorVersion:1};await db.collection('render_jobs').insertOne({id:identity.jobId,clip_id:identity.clipId,user_id:identity.userId,status:'queued',worker_id:null,locked_at:null,attempts:0,max_attempts:3,...extra});return identity;};
 for(const attempts of[0,null]){const id=await seed({attempts});const row=await claimRenderLease(db,id,now);assert.equal(row?.attempts,1);assert.equal(row?.worker_id,id.workerId);}checks.push({name:'actual production claim starts first execution at attempt one, including null legacy count',passed:true});
 let id=await seed({attempts:3,max_attempts:5});assert.equal((await claimRenderLease(db,id,now))?.attempts,4);checks.push({name:'actual production claim honors a configured budget above three',passed:true});
 id=await seed({attempts:3,max_attempts:3});assert.equal(await claimRenderLease(db,id,now),null);checks.push({name:'exhausted queued job cannot acquire another execution',passed:true});
 id=await seed();assert.equal(await claimRenderLease(db,{...id,userId:crypto.randomUUID()},now),null);assert.equal(await claimRenderLease(db,{...id,clipId:crypto.randomUUID()},now),null);checks.push({name:'wrong owner or clip cannot claim a job',passed:true});
 id=await seed();const result=await Promise.all([claimRenderLease(db,id,now),claimRenderLease(db,{...id,workerId:'second-worker'},now)]);assert.equal(result.filter(Boolean).length,1);checks.push({name:'two actual competing claims acquire exactly once',passed:true});
 id=await seed({status:'processing',worker_id:'previous-worker',locked_at:new Date(now.getTime()-16*60*1000),attempts:2});assert.equal((await claimRenderLease(db,id,now))?.attempts,3);checks.push({name:'expired processing lease claims final allowed execution exactly once',passed:true});
 const output={database:'vireo_render_retry_20261119_0015',actualProductionClaimMethod:true,checks,retainedJobs:await db.collection('render_jobs').countDocuments(),noRenderMediaProviderStorage:true};fs.writeFileSync('/downloads/vireo-render-fence-0006/actual-claim-result.json',JSON.stringify(output,null,2));console.log(JSON.stringify(output,null,2));
}finally{await client.close();}
