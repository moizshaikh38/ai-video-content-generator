const probe=JSON.parse(execFileSync('ffprobe',['-v','error','-show_streams','-show_format','-of','json',source],{encoding:'utf8'})),v=probe.streams.find((s:any)=>s.codec_type==='video');assert(v.width>0&&v.height>0);
const asset=sourceOverride?'local-second-source-fresh-cv':freshEvidence?'local-walking-fresh-cv':'local-walking-archived-replay',sourceStoragePath=sourceOverride?'qualification/second-source-12s.mp4':'qualification/walking-12s.mp4',start=process.env.VIREO_FIXTURE_FULL_SOURCE==='1'?0:2.7,duration=process.env.VIREO_FIXTURE_FULL_SOURCE==='1'?Number(probe.format.duration):3;
const track:any={clip_id:asset,status:'ready',analysis_version:1,analyzed_aspect_ratio:'9:16',source_width:v.width,source_height:v.height,raw_samples:evidence.samples,smoothed_keyframes:[{time:0,centerX:.5,centerY:.5}],metadata:{shot_composition_candidate:true,clip_duration:Number(probe.format.duration),analyzed_source_start:0,analyzed_source_end:Number(probe.format.duration),analyzed_source_sha256:sourceSha256,analyzed_source_path:sourceStoragePath}};
const normalTrack=analysisPath&&fs.existsSync(path.join(path.dirname(analysisPath),'track.json'))?JSON.parse(fs.readFileSync(path.join(path.dirname(analysisPath),'track.json'),'utf8')):null;
if(normalTrack){track.metadata={...normalTrack.metadata,...track.metadata,shot_composition_window_scope:normalTrack.metadata.shot_composition_window_scope,automatic_fit_aspect:normalTrack.metadata.automatic_fit_aspect,scene_cuts:normalTrack.metadata.scene_cuts};}
const item:any={id:'bound-effective-walking-slice',source_asset_id:asset,source_path:sourceStoragePath,source_start:start,source_end:start+duration,timeline_start:0,timeline_end:duration};
if(process.env.VIREO_FIXTURE_CANDIDATE==='review-v1')item.crop_config={automaticLayoutCandidate:'review-v1'};
const ctx:any={mode:'smart',aspectRatio:'9:16',clipStartSec:0,layoutMode:'track',track,sourceSha256,sourceAssetId:asset,sourceStoragePath,decodedSource:{width:v.width,height:v.height},canvasScale:2/3,sourceHasAudio:probe.streams.some((s:any)=>s.codec_type==='audio')};
const resolved=resolveMeasuredItemPlan(item,ctx,o=>S.computeShotComposition(o));assert.equal(resolved.status,'ready');
const project:any={canvas:{width:1080,height:1920,aspect_ratio:'9:16',fps:30,duration},tracks:[{type:'VIDEO',name:freshEvidence?'Fresh measured-plan source slice':'Archived measured-plan replay',items:[item]}]},before=JSON.stringify(project),output=path.join(out,sourceOverride?'actual-bound-second-source.mp4':'actual-bound-walking.mp4');
const graph=P.compileRenderGraph(project,source,output,out,ctx,'off');
const previous=(P as any).resolveShotCompositionPlan;
let oldGraph;try{(P as any).resolveShotCompositionPlan=(i:any,c:any)=>S.computeShotComposition(shotPlanOptions({track:c.track,candidate:i.crop_config?.automaticLayoutCandidate,layoutPolicy:i.crop_config?.layoutPolicy||c.cropConfig?.layoutPolicy,duration:Number(c.track.metadata.clip_duration)}));oldGraph=P.compileRenderGraph(project,source,output,out,ctx,'off');}finally{(P as any).resolveShotCompositionPlan=previous;}
assert.deepEqual(graph,oldGraph);assert.equal(JSON.stringify(project),before);
for(const mutate of[(c:any)=>c.sourceSha256='b'.repeat(64),(c:any)=>c.sourceStoragePath='changed',(c:any)=>c.decodedSource.width=1920]){const c=structuredClone(ctx);mutate(c);assert.throws(()=>P.compileRenderGraph(project,source,output,out,c,'off'),(e:any)=>e.code==='AUTOMATIC_PLAN_REVIEW_REQUIRED');}
const args=['-nostdin','-v','error','-y','-threads','1','-filter_threads','1','-filter_complex_threads','1','-ss',String(start),...graph.inputArgs,'-filter_complex',graph.filterComplex.join(';'),'-map',graph.videoMap,'-map',graph.audioMap,'-t',String(duration),'-c:v','libx264','-threads','1','-preset','ultrafast','-crf','22','-c:a','aac',output];
fs.writeFileSync(path.join(out,'prepared.json'),JSON.stringify({source,sourceSha256,evidenceProvenance:freshEvidence||evidence.provenance,archivedDetectionAssociationNotFreshlyVerified:!freshEvidence,freshCvExecution:Boolean(freshEvidence),project,ctx,resolved,graph,args},null,2));execFileSync('ffmpeg',args,{timeout:60000});
const outputProbe=JSON.parse(execFileSync('ffprobe',['-v','error','-count_frames','-show_streams','-show_format','-of','json',output],{encoding:'utf8'}));const ov=outputProbe.streams.find((s:any)=>s.codec_type==='video');assert.equal(ov.width,720);assert.equal(ov.height,1280);assert.equal(Number(ov.nb_read_frames),Math.round(duration*30));
fs.writeFileSync(path.join(out,'result.json'),JSON.stringify({sourceSha256,outputProbe,exactSameGraphForValidInput:true,savedProjectUnchanged:JSON.stringify(project)===before,wrongHashPathAndDecodedGeometryRejected:true,providerCalls:0,freshCvExecution:Boolean(freshEvidence),qualityAccepted:false},null,2));console.log('BOUND_REAL_SOURCE_REPLAY_PASS',output);
