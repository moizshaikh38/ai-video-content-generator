import assert from'node:assert/strict';import crypto from'node:crypto';import fs from'node:fs';import{MongoClient}from'mongodb';import{recoverRenderQueue}from'../../src/services/queue/renderQueueRecovery.js';import{renderBudgetAvailableExpr,renderRetryBudget}from'../../src/shared/renderRetryBudget.js';
const client=new MongoClient('mongodb://127.0.0.1:27020/?replicaSet=homeproof',{maxPoolSize:3,serverSelectionTimeoutMS:3000});const name='vireo_render_retry_20261119_0015',checks:any[]=[];const now=new Date('2026-11-19T00:15:00+05:30'),stale=new Date(now.getTime()-16*60*1000);
