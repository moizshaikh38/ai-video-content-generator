 await recoverRenderQueue(client,wrapped,now);assert.equal((await read(race)).job?.worker_id,'worker-replacement');assert.equal((await read(race)).job?.status,'processing');checks.push({name:'heartbeat/token changed between scan and transaction defeats stale recovery',passed:true});
