 const retry=await seed('retry'),exhausted=await seed('exhausted',{attempts:3}),higher=await seed('higher',{attempts:3,max_attempts:5}),fresh=await seed('fresh',{locked_at:now}),queuedExhausted=await seed('queued-exhausted',{status:'queued',worker_id:null,locked_at:null,attempts:5,max_attempts:5}),malformed=await seed('malformed',{attempts:'bad'}),legacy=await seed('legacy',{render_version:null});
 const got=await recoverRenderQueue(client,db,now);assert.equal(got,6);const read=async(j:any)=>({job:await db.collection('render_jobs').findOne({id:j.id}),clip:await db.collection('clips').findOne({id:j.clip_id})});
