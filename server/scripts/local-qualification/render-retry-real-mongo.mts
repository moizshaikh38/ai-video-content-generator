 for(const j of[exhausted,queuedExhausted,malformed]){const s=await read(j);assert.equal(s.job?.status,'failed');assert.equal(s.clip?.render_status,'failed');}checks.push({name:'exhausted and invalid-count jobs become failed instead of stranded queued',passed:true});
