 const samples=[{}, {attempts:null,max_attempts:null},{attempts:0,max_attempts:1},{attempts:3,max_attempts:5},{attempts:5,max_attempts:5},{attempts:'1'},{max_attempts:'3'},{attempts:-1},{max_attempts:0},{attempts:.5}];for(const sample of samples){const id=crypto.randomUUID();await db.collection('render_jobs').insertOne({id,status:'budget-fixture',...sample});const mongo=!!await db.collection('render_jobs').findOne({id,$expr:renderBudgetAvailableExpr});assert.equal(mongo,renderRetryBudget(sample).available);}checks.push({name:'real Mongo due/claim expression matches JS budget policy for ten legacy/invalid/configured inputs',passed:true});
