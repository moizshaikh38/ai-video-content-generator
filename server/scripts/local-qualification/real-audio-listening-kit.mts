/** Two real source windows and existing DSP; neutral files for an independent
 * listener, no listening verdict or default processing change. */
import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';import assert from 'node:assert/strict';import{execFileSync}from'node:child_process';
import{AudioEnhancementService as A}from'../../src/services/audioEnhancementService.js';import{AUDIO_CLEAN_PRESETS}from'../../src/types/index.js';import{reviewEncodedAudio}from'../../src/services/encodedAudioReviewService.js';
const [source,out]=process.argv.slice(2);if(!source||!out||fs.existsSync(out))throw Error('Source and new output directory required');fs.mkdirSync(out,{recursive:true});const review=path.join(out,'listener-only');fs.mkdirSync(review);const hash=(p:string)=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');const sourceHash=hash(source),key:any[]=[];
for(const[start,index]of[[0,1],[18,2]]){const rows:any[]=[];for(const preset of['off','natural']as const){const r=await A.generatePreviewSnippet(source,AUDIO_CLEAN_PRESETS[preset],start,6),copy=path.join(out,`window-${index}-${preset}.m4a`);fs.copyFileSync(r.preview_audio_path,copy);fs.rmSync(r.preview_audio_path,{force:true});const measured=await reviewEncodedAudio(copy,false);assert(Number.isFinite(measured.integrated_lufs));rows.push({preset,file:copy,measured,config:AUDIO_CLEAN_PRESETS[preset],serviceBefore:r.before_metrics,serviceAfter:r.after_metrics});}
 const target=Math.min(-18,...rows.map(r=>r.measured.integrated_lufs)),order=index===1?[0,1]:[1,0];
 for(let n=0;n<2;n++){const row=rows[order[n]],gain=target-row.measured.integrated_lufs,file=path.join(review,`window-${index}-${n===0?'A':'B'}.wav`);execFileSync('ffmpeg',['-nostdin','-v','error','-y','-i',row.file,'-af',`volume=${gain.toFixed(6)}dB`,'-c:a','pcm_s16le',file],{timeout:15000});const matched=await reviewEncodedAudio(file,false);assert(Math.abs(matched.integrated_lufs!-target)<.25);key.push({window:index,sourceStart:start,duration:6,label:n===0?'A':'B',preset:row.preset,gainDb:gain,targetLufs:target,beforeMatch:row.measured,matched,sha256:hash(file),config:row.config});}
}
assert.equal(hash(source),sourceHash);fs.writeFileSync(path.join(out,'private-key-and-meters.json'),JSON.stringify({source,sourceHash,sourceUnchanged:true,providerCalls:0,listeningVerified:false,representativeCleanNoiseShoutMusicSet:false,key},null,2));fs.writeFileSync(path.join(review,'review-form.json'),JSON.stringify({reviewer:null,reviewedAt:null,priorExposure:null,headphonesOrSpeakers:null,device:null,windows:[1,2].map(window=>({window,preferred:null,wordsLessClear:null,addedArtifacts:null,pumping:null,backgroundBalance:null,comment:null})),listeningVerified:false},null,2));fs.writeFileSync(path.join(review,'README.txt'),'Compare A and B for each numbered window at a comfortable unchanged playback volume. Levels were matched by constant gain after rendering. Record clarity, added artifacts, pumping and background balance in the empty form. The loudness/peak measurements and a successful render do not establish listening quality. Do not infer which sample is processed. This is one source and two windows, not a representative audio benchmark.\n');console.log('REAL_AUDIO_LISTENING_KIT_PREPARED');
