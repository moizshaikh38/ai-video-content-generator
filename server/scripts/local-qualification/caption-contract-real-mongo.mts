 const next=structuredClone(project);next.version=2;next.tracks[0].items[0].caption.cues=[{id:'saved-cue',start:1,end:2,text:'User saved words'}];await db.collection('editor_projects').updateOne({id:project.id},{$set:{version:2,tracks:next.tracks}});
