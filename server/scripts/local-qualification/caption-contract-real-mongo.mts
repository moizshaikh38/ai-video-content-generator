const out='/downloads/vireo-caption-contract-0048';fs.mkdirSync(out,{recursive:true});const checks:any[]=[];const clip:any={id:crypto.randomUUID(),user_id:crypto.randomUUID(),project_id:crypto.randomUUID(),start_seconds:0,end_seconds:10,aspect_ratio:'9:16',caption_enabled:true,caption_style:'clean'};
