 const result={database:'vireo_caption_contract_20261119_0049',checks,actualCaptionServiceMongoAndAssWrites:true,retainedDocuments:{editorProjects:await db.collection('editor_projects').countDocuments(),transcripts:await db.collection('transcripts').countDocuments()},noEncoderAsrSourceAcquisitionExternalStorageOrProductionAccess:true,captionAccuracyAndFullRenderNotProven:true,artifacts:fs.readdirSync(out).filter(n=>n.endsWith('.ass')).map(n=>({name:n,bytes:fs.statSync(out+'/'+n).size}))};fs.writeFileSync(out+'/real-service-result.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result,null,2));
