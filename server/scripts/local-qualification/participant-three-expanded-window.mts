/** Offline only: ratio-constrained face windows can grow within a nearest-face horizontal partition. Not a body-safe plan or production assignment. */
import fs from'node:fs';import{execFileSync}from'node:child_process';import{buildPanelsFilter,PANEL_RECTS}from'../../src/shared/panelLayouts.js';
const root=process.argv[2],out=process.argv[3];if(!root||!out||fs.existsSync(out))throw Error('Unique output required');fs.mkdirSync(out,{recursive:true});const t=JSON.parse(fs.readFileSync(root+'/fresh-normal-track.json','utf8')),samples=t.raw_samples;const ids=[...new Set<string>(samples.flatMap((s:any)=>s.faces.map((f:any)=>f.track_id)))].sort((a,b)=>{const mean=(id:string)=>samples.flatMap((s:any)=>s.faces.filter((f:any)=>f.track_id===id)).reduce((q:number,f:any)=>q+f.center_x,0)/samples.length;return mean(a)-mean(b)});if(ids.length!==3)throw Error('Three measured tracks required');const bounds=ids.map(id=>{const faces=samples.flatMap((s:any)=>s.faces.filter((f:any)=>f.track_id===id));if(faces.length!==samples.length)throw Error('Every track must be observed every sample');return{left:Math.min(...faces.map((f:any)=>f.x-f.width*.35)),right:Math.max(...faces.map((f:any)=>f.x+f.width*1.35)),top:Math.min(...faces.map((f:any)=>f.y-f.height*.9)),bottom:Math.max(...faces.map((f:any)=>f.y+f.height*1.6))}});
const slots=bounds.map((b,i)=>{const ratio=PANEL_RECTS.three[i].w*9/(PANEL_RECTS.three[i].h*16)*t.source_height/t.source_width,w=Math.max(b.right-b.left,(b.bottom-b.top)*ratio),h=w/ratio;const lo=i? (bounds[i-1].right+b.left)/2:0,hi=i<2?(b.right+bounds[i+1].left)/2:1;if(w>hi-lo)throw Error('No isolated window');const x=Math.max(lo,Math.min(hi-w,(b.left+b.right-w)/2)),y=Math.max(0,Math.min(1-h,(b.top+b.bottom-h)/2));if(x>b.left+1e-9||x+w<b.right-1e-9||y>b.top+1e-9||y+h<b.bottom-1e-9)throw Error('Insufficient full-face margin');return{focusX:.5,focusY:.5,scale:1,set:true,sourceRect:{x,y,w,h}}});const panels={layout:'three' as const,slots};for(const s of samples)for(let i=0;i<3;i++){const r=slots[i].sourceRect;for(const f of s.faces)if(f.track_id!==ids[i]&&f.x<r.x+r.w&&f.x+f.width>r.x&&f.y<r.y+r.h&&f.y+f.height>r.y)throw Error('Foreign face fragment')};fs.writeFileSync(out+'/proposal.json',JSON.stringify({offlineOnly:true,bodySafetyNotQualified:true,ids,bounds,panels},null,2));const filter=buildPanelsFilter(panels,720,1280);execFileSync('ffmpeg',['-nostdin','-v','error','-y','-filter_complex_threads','1','-threads','1','-i',root+'/verified-source.mp4','-filter_complex','[0:v]'+filter+'[out]','-map','[out]','-map','0:a?','-t','14','-c:v','libx264','-threads','1','-preset','ultrafast','-crf','20','-c:a','aac',out+'/offline-three-expanded.mp4']);console.log('Offline Three window prototype rendered');
