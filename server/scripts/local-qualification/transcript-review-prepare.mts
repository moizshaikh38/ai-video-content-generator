/** Prepare a blind source-review folder from an already completed STT run.
 * No network, STT, inferred reference, metrics or provenance approval. */
import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';import assert from 'node:assert/strict';
const [source,run,out]=process.argv.slice(2);if(!source||!run||!out)throw Error('Supply SOURCE_MEDIA COMPLETED_RUN_DIR NEW_OUTPUT_DIR');if(fs.existsSync(out))throw Error('Refuse overwrite of review evidence');
const sha=(file:string)=>crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
const attempt=JSON.parse(fs.readFileSync(path.join(run,'attempt.json'),'utf8')),result=JSON.parse(fs.readFileSync(path.join(run,'result.json'),'utf8')),response=JSON.parse(fs.readFileSync(path.join(run,'raw-response.json'),'utf8')),metadata=JSON.parse(fs.readFileSync(path.join(run,'response-metadata.json'),'utf8'));
const sourceSha256=sha(source),audio=path.join(run,'prepared-audio.wav'),audioSha256=sha(audio);
assert.equal(sourceSha256,attempt.sourceHash,'Exact source bytes must match recorded run');assert.equal(sourceSha256,result.sourceHash);assert.equal(audioSha256,attempt.audioSha256);assert.equal(audioSha256,result.audioSha256);assert.equal(result.ok,true);assert.equal(result.calls,1);assert.equal(metadata.status,200);assert.equal(attempt.reference,'not yet independently reviewed');
if(!Array.isArray(response.words)||!response.words.length||response.words.some((w:any)=>typeof w.word!=='string'||!Number.isFinite(w.start)||!Number.isFinite(w.end)))throw Error('Missing raw provider words/clocks');
const reviewer=path.join(out,'blind-review'),separate=path.join(out,'hypothesis-do-not-give-to-blind-reviewer');fs.mkdirSync(reviewer,{recursive:true});fs.mkdirSync(separate);
fs.copyFileSync(source,path.join(reviewer,'source'+path.extname(source)));fs.copyFileSync(audio,path.join(reviewer,'source-audio.wav'));
const reference={schemaVersion:1,sourceSha256,sourceAudioSha256:audioSha256,caseId:'real-en-source-20261118',reviewerId:null,reviewedAt:null,reviewedWithoutReadingHypothesis:null,reviewEvidence:null,language:null,noiseBucket:null,unintelligibleRanges:[],tokenizationNotes:[],words:[]};
fs.writeFileSync(path.join(reviewer,'reference.blank.json'),JSON.stringify(reference,null,2),{flag:'wx'});
fs.writeFileSync(path.join(reviewer,'REVIEW.md'),`# Source-only transcript review\n\nThis folder intentionally contains no machine transcript or guessed words/timings. Do not open the separate hypothesis folder before completing this review. Prior exposure must be declared; it cannot be undone by hiding a transcript now.\n\nListen to the full source audio, including pauses, overlapping speech and background speech. Write exactly the audible words in reference.blank.json as individual word entries with text. Add start/end source-audio seconds only when independently checked; absent clocks remain unavailable, not zero. Do not copy provider timing boundaries. Mark names/numbers with tags only where the reference supports them. Preserve language; do not translate or repair grammar. Record uncertain or unintelligible intervals separately instead of guessing words. Record language and an honest noise description. Do not derive either from the hypothesis.\n\nRecord reviewer identity, review date/time, whether any hypothesis was seen, and retrievable review evidence. Source SHA256: ${sourceSha256}. Source audio SHA256: ${audioSha256}. Both are exact-byte anchors, not proof of reference authorship or quality.\n\nDo not preselect independently-reviewed provenance. A later evaluation must inspect the actual review evidence and disclose any prior exposure. One source never establishes Hindi/noisy/holdout generalization. Empty words here means unreviewed, not perfect recognition.\n`,{flag:'wx'});
const hypothesis={provider:'openrouter',model:attempt.model,execution:'actual-provider',manuallyCorrected:false,words:response.words.map((w:any)=>({text:w.word,start:w.start,end:w.end}))};
fs.writeFileSync(path.join(separate,'hypothesis.json'),JSON.stringify(hypothesis,null,2),{flag:'wx'});fs.copyFileSync(path.join(run,'raw-response.json'),path.join(separate,'raw-response.json'));
const manifest={createdAt:new Date().toISOString(),status:'awaiting-independent-source-review',source,sourceSha256,audioSha256,providerRun:{runDirectory:run,generationId:metadata.generationId,recordedStartedAt:attempt.startedAt,model:attempt.model,rawResponseSha256:sha(path.join(run,'raw-response.json'))},hypothesisWordRecords:response.words.length,referenceWords:0,providerCallsMadeByThisPreparation:0,metricsProduced:false,provenanceAuthentication:'Run records locate the earlier execution; this script checks consistency, not authorship or independent reference evidence.',knownTokenizationCaveat:'Raw provider records retained verbatim. Dialogue markers, hyphenated words, numeric signs and multiword records require explicit normalization/tokenization review. Do not silently merge/split or correct them to improve WER.'};
fs.writeFileSync(path.join(out,'manifest.json'),JSON.stringify(manifest,null,2),{flag:'wx'});console.log(JSON.stringify({out,status:manifest.status,sourceSha256,hypothesisWordRecords:response.words.length,referenceWords:0,metricsProduced:false}));
