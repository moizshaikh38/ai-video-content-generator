/** Local saved-receipt controls only. No media decode, external calls or render. */
import fs from'node:fs';import assert from'node:assert/strict';import{SmartReframeService as S}from'../../src/services/smartReframeService.js';import{proposeAutomaticGamingPanels,gamingGenreFromVisualReview}from'../../src/shared/automaticGamingPanels.js';import{shotPlanOptions}from'../../src/shared/shotPlanOptions.js';
const e=JSON.parse(fs.readFileSync(process.argv[2],'utf8'));const out=process.argv[3];assert(out&&!fs.existsSync(out));fs.mkdirSync(out,{recursive:true});const cases:any[]=[];
const variants:[string,(v:any)=>void,number?][]=[['recorded-valid',()=>{}],['wrong-duration',()=>{},e.durationSeconds+3],['missing-duration',v=>delete v.durationSeconds],['tail-unobserved',v=>v.semantic.frames.pop()],['late-only',v=>v.semantic.frames[0].time=2],['beyond-source',v=>v.semantic.frames[v.semantic.frames.length-1].time=e.durationSeconds+1],['nonfinite-size',v=>v.sourceWidth=v.semantic.sourceWidth=Infinity],['fractional-observation-count',v=>v.inset.proposals[0].observed_frames-=.5]];
for(const[name,mutate,duration]of variants){const v=structuredClone(e);mutate(v);const d=duration??e.durationSeconds;const plan=S.computeShotComposition({rawSamples:[{time:0,faces:[]}],sourceWidth:v.sourceWidth,sourceHeight:v.sourceHeight,duration:d,automaticGamingReview:v});const result={name,proposal:!!proposeAutomaticGamingPanels(v),gamingPlan:plan.some(s=>s.split?.focusPanels?.layout==='gameplay'),genreReview:!!gamingGenreFromVisualReview(e.sourceSha256,v,d)};assert.equal(result.gamingPlan,name==='recorded-valid',name);assert.equal(result.genreReview,name==='recorded-valid',name);cases.push(result)}
const mismatched=shotPlanOptions({track:{source_width:e.sourceWidth,source_height:e.sourceHeight,metadata:{analyzed_source_sha256:'b'.repeat(64),automatic_gaming_review_enabled:true,automatic_gaming_evidence:e}},duration:e.durationSeconds});assert.equal(mismatched.automaticGamingReview,undefined);fs.writeFileSync(out+'/result.json',JSON.stringify({recordedSourceSha256:e.sourceSha256,recordedDuration:e.durationSeconds,cases,wrongAnalyzedSourceRejected:true,mediaDecode:false,externalCalls:0,paidCalls:0,render:false,onlyInputContractQualification:true},null,2));console.log('RECORDED_GAMING_RECEIPT_SCOPE_PASS');
