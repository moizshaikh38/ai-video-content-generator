/** Local actual-media geometry regression only. Manual intervals/crop, no provider/API. */
import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';import assert from 'node:assert/strict';import {execFileSync} from 'node:child_process';
import {ProEditorService} from '../../src/services/proEditorService.js';
const out=process.argv[2];if(!out||fs.existsSync(out))throw Error('Supply new evidence directory');fs.mkdirSync(out,{recursive:true});
const source='/downloads/rank1-clean-source-approx-aligned.mp4',sourceSha256=crypto.createHash('sha256').update(fs.readFileSync(source)).digest('hex');assert.equal(sourceSha256,'77077a07ad64772757648b96a98f4ed05b0beaf50df231fabd767dd768a2d70d');
const item=(id:string,timeline_start:number,source_start:number,transition=false)=>({id,track_id:'v',type:'VIDEO',timeline_start,timeline_end:timeline_start+2,source_start,source_end:source_start+2,transform:{position_x:0,position_y:0,scale:1,rotation:0,opacity:1},speed:{speed:1,pitch_preserved:true},effects:[],keyframes:[],hidden:false,muted:false,...(transition?{transition_in:{type:'zoom_lite',duration:.4}}:{})});
const project:any={id:'zoom-geometry',user_id:'local-fixture',clip_id:'local-fixture',project_id:'local-fixture',version:1,canvas:{width:320,height:568,aspect_ratio:'9:16',fps:30,duration:4},tracks:[{id:'v',type:'VIDEO',name:'Manual source intervals',hidden:false,items:[item('a',0,0),item('b',2,3.3,true)]}]};
const before=JSON.stringify(project),file=path.join(out,'actual-transition.mp4'),graph=ProEditorService.compileRenderGraph(project,source,file,out,{aspectRatio:'9:16',canvasScale:2/3,mode:'manual',cropConfig:{mode:'center'},clipStartSec:0,layoutMode:'track',track:null,sourceHasAudio:true});assert.equal(JSON.stringify(project),before);
const args=['-nostdin','-v','error','-y','-filter_complex_threads','1','-filter_threads','1',...graph.inputArgs,'-filter_complex',graph.filterComplex.join(';'),'-map',graph.videoMap,'-map',graph.audioMap,'-c:v','libx264','-threads','1','-preset','ultrafast','-crf','22','-c:a','aac','-b:a','160k',file];
fs.writeFileSync(path.join(out,'prepared.json'),JSON.stringify({source,sourceSha256,project,graph,argv:args,manualIntervalsAndCenter:true,recognitionAccuracyQualified:false},null,2));execFileSync('ffmpeg',args,{timeout:60000});
const probe=JSON.parse(execFileSync('ffprobe',['-v','error','-show_streams','-show_format','-of','json',file],{encoding:'utf8'}));const v=probe.streams.find((s:any)=>s.codec_type==='video');assert.equal(v.width,720);assert.equal(v.height,1280);assert(Math.abs(Number(probe.format.duration)-3.6)<.15);fs.writeFileSync(path.join(out,'result.json'),JSON.stringify({sourceSha256,probe,savedProjectUnchanged:JSON.stringify(project)===before,providerCalls:0,full4KAttempt:false},null,2));console.log('ACTUAL_ZOOM_CANVAS_EXPORT_PASS',file);
