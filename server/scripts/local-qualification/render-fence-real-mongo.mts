import fs from'node:fs';import assert from'node:assert/strict';import crypto from'node:crypto';import{MongoClient}from'mongodb';import{commitFencedRenderOutcome}from'../../src/services/queue/renderLeaseCommit.js';
// Deliberately fixed loopback endpoint and NEW database. No inherited env URI,
// no old database reads, no renderer/provider/storage calls, no deletes/drops.
const uri='mongodb://127.0.0.1:27020/?replicaSet=homeproof';const database='vireo_render_fence_20261119_0006';const evidence='/downloads/vireo-render-fence-0006';
assert.equal(new URL(uri).hostname,'127.0.0.1');assert.equal(database,'vireo_render_fence_20261119_0006');
const client=new MongoClient(uri,{serverSelectionTimeoutMS:3000,connectTimeoutMS:3000,maxPoolSize:3});
const checks:Array<{name:string;passed:boolean;details?:unknown}>=[];
try{
 await client.connect();const db=client.db(database);const hello=await db.admin().command({hello:1});assert.equal(hello.setName,'homeproof');assert.equal(hello.isWritablePrimary,true);
 assert.equal((await db.listCollections({}, {nameOnly:true}).toArray()).length,0,'Refuse to reuse an existing database');
 await db.createCollection('render_jobs');
 await db.createCollection('clips',{validator:{$or:[{reject_ready:{$ne:true}},{render_status:{$ne:'ready'}}]}});
 const seed=async(name:string,options:{worker?:string;rejectReady?:boolean;missingClip?:boolean;editor?:number}={})=>{const id={jobId:crypto.randomUUID(),clipId:crypto.randomUUID(),userId:crypto.randomUUID(),workerId:'worker-original',renderVersion:1,editorVersion:1};await db.collection('render_jobs').insertOne({id:id.jobId,clip_id:id.clipId,user_id:id.userId,worker_id:options.worker||id.workerId,status:'processing',test_case:name});if(!options.missingClip)await db.collection('clips').insertOne({id:id.clipId,user_id:id.userId,render_status:'rendering',render_version:1,editor_version:options.editor||1,reject_ready:!!options.rejectReady,test_case:name});return id;};
 const done={job:{status:'completed',worker_id:null},clip:{render_status:'ready',output_storage_path:'isolated-test-attempt-key'}};
 const failed={job:{status:'failed',worker_id:null},clip:{render_status:'failed'}};
 const state=async(id:any)=>({job:await db.collection('render_jobs').findOne({id:id.jobId}),clip:await db.collection('clips').findOne({id:id.clipId})});
 let id=await seed('commit-success');await commitFencedRenderOutcome(client,db,id,done);let s=await state(id);assert.equal(s.job?.status,'completed');assert.equal(s.clip?.render_status,'ready');checks.push({name:'real snapshot transaction commits both records',passed:true});
 id=await seed('stale-token',{worker:'worker-replacement'});let before=await state(id);await assert.rejects(commitFencedRenderOutcome(client,db,id,failed),{code:'FENCING_TOKEN_MISMATCH'});assert.deepEqual(await state(id),before);checks.push({name:'replacement worker survives stale failure unchanged',passed:true});
 id=await seed('wrong-owner');before=await state(id);await assert.rejects(commitFencedRenderOutcome(client,db,{...id,userId:crypto.randomUUID()},done),{code:'FENCING_TOKEN_MISMATCH'});assert.deepEqual(await state(id),before);checks.push({name:'wrong owner cannot commit',passed:true});
 id=await seed('schema-rollback',{rejectReady:true});before=await state(id);await assert.rejects(commitFencedRenderOutcome(client,db,id,done),(e:any)=>e.code===121);assert.deepEqual(await state(id),before);checks.push({name:'actual Mongo clip validation failure rolls back prior job write',passed:true});
 id=await seed('missing-clip',{missingClip:true});before=await state(id);await assert.rejects(commitFencedRenderOutcome(client,db,id,done),{code:'CLIP_NOT_FOUND'});assert.deepEqual(await state(id),before);checks.push({name:'missing clip rolls back prior job write',passed:true});
 id=await seed('newer-editor',{editor:2});before=await state(id);await assert.rejects(commitFencedRenderOutcome(client,db,id,done),{code:'RENDER_INPUT_CHANGED'});assert.deepEqual(await state(id),before);await commitFencedRenderOutcome(client,db,id,{...failed,preserveSupersedingClip:true});s=await state(id);assert.equal(s.job?.status,'failed');assert.equal(s.job?.error_code,'RENDER_INPUT_CHANGED');assert.deepEqual(s.clip,before.clip);checks.push({name:'newer edit rejects old success; old failure preserves newer clip',passed:true});
 id=await seed('concurrent-terminal-conflict');const results=await Promise.allSettled([commitFencedRenderOutcome(client,db,id,done),commitFencedRenderOutcome(client,db,id,failed)]);assert.equal(results.filter(x=>x.status==='fulfilled').length,1);const rejected=results.find(x=>x.status==='rejected')as PromiseRejectedResult;assert.equal(rejected.reason.code,'FENCING_TOKEN_MISMATCH');s=await state(id);assert((s.job?.status==='completed'&&s.clip?.render_status==='ready')||(s.job?.status==='failed'&&s.clip?.render_status==='failed'));checks.push({name:'simultaneous real transactions have exactly one fenced winner',passed:true,details:{winnerJobStatus:s.job?.status,winnerClipStatus:s.clip?.render_status}});
 const result={database,loopbackOnly:true,replicaSet:hello.setName,mongoVersion:(await db.admin().command({buildInfo:1})).version,checks,retainedDocuments:{jobs:await db.collection('render_jobs').countDocuments(),clips:await db.collection('clips').countDocuments()},noMediaProviderStorageOrProductionAccess:true,storageRaceNotTested:true};fs.mkdirSync(evidence,{recursive:true});fs.writeFileSync(evidence+'/real-mongo-result.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result,null,2));
}finally{await client.close();}
