Object.assign(process.env,{NODE_ENV:'test',MONGODB_URI:'mongodb://127.0.0.1:27020/?replicaSet=homeproof',MONGODB_DB_NAME:'vireo_selection_unchanged_qualification',SUPABASE_URL:'http://127.0.0.1:5998',SUPABASE_SECRET_KEY:'local-fixture',R2_ACCOUNT_ID:'localfixture',R2_ACCESS_KEY_ID:'localfixture',R2_SECRET_ACCESS_KEY:'localfixture',R2_ENDPOINT:'http://127.0.0.1:5588',R2_SOURCE_BUCKET:'source',R2_CLIPS_BUCKET:'clips',OPENROUTER_API_KEY:'',GROQ_API_KEY:'',GAME_EVENTS_AUTO:'off',MULTIMODAL_AUTO:'off',SMART_REFRAME_ENABLED:'false',REFRAME_AUTO_GENERATE:'false',RENDER_FFMPEG_PRESET:'ultrafast'});
