fs.writeFileSync(path.join(out,'result.json'),JSON.stringify({commit:execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),source,sourceSha256:sha,syntheticTranscript:true,captionsOff:true,assistedProtocolOnly:true,clip,job,puts,putPaths,gets,probe},null,2));console.log('UNCHANGED_SOURCE_EXPORT_PASS');
}finally{for(const c of ['projects','transcripts','clip_candidates','clips','render_jobs'])await db.collection(c).deleteMany({user_id:user});await closeMongo();await new Promise<void>(r=>storage.close(()=>r()));}
