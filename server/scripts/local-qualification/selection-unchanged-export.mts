t.source_binding={version:1,source_receipt:{key,size:sourceBytes.length,etag,sha256:sha},prepared_audio_sha256:'b'.repeat(64),requests:[{sha256:'b'.repeat(64),bytes:7,status:'completed'}],transcript_content_sha256:transcriptContentIdentity(t)};const receipt=selectionSourceReceipt(t,key);
