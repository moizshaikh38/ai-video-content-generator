/** Offline only. No geometry overrides in a product controller. */
import fs from'node:fs';import{execFileSync}from'node:child_process';import{assignParticipantPanels}from'../../src/shared/participantPanels.js';import{buildPanelsFilter,PANEL_RECTS}from'../../src/shared/panelLayouts.js';
const root=process.argv[2],out=process.argv[3];if(!root||!out||fs.existsSync(out))throw Error('Unique output and existing track directory required');fs.mkdirSync(out,{recursive:true});const track=JSON.parse(fs.readFileSync(root+'/fresh-normal-track.json','utf8')),prior=JSON.parse(fs.readFileSync(root+'/result.json','utf8'));const proposal=assignParticipantPanels(track.raw_samples,track.source_width,track.source_height,{allowFaceWindowReview:true});if(!proposal)throw Error('No isolated face-window assignment');
const report:any[]=[];proposal.panels.slots=proposal.panels.slots.map((slot,i)=>{const fs=track.raw_samples.flatMap((s:any)=>s.faces.filter((f:any)=>f.track_id===proposal.trackIds[i]));const b=slot.sourceRect!,need={left:Math.min(...fs.map((f:any)=>f.x-f.width*.15)),right:Math.max(...fs.map((f:any)=>f.x+f.width*1.15)),top:Math.min(...fs.map((f:any)=>f.y-f.height*.15)),bottom:Math.max(...fs.map((f:any)=>f.y+f.height*1.15))};if(need.left<b.x-1e-6||need.top<b.y-1e-6||need.right>b.x+b.w+1e-6||need.bottom>b.y+b.h+1e-6)throw Error('Full measured face union and margin do not fit');const target=PANEL_RECTS[proposal.panels.layout][i],ratio=target.w*9/(target.h*16)*track.source_height/track.source_width;const nw=need.right-need.left,nh=need.bottom-need.top,w=Math.max(nw,nh*ratio),h=w/ratio;const lx=Math.max(b.x,need.right-w),hx=Math.min(b.x+b.w-w,need.left),ly=Math.max(b.y,need.bottom-h),hy=Math.min(b.y+b.h-h,need.top);const exact=lx<=hx+1e-6&&ly<=hy+1e-6;const r=exact?{x:Math.max(lx,Math.min(hx,(need.left+need.right-w)/2)),y:Math.max(ly,Math.min(hy,(need.top+need.bottom-h)/2)),w,h}:{x:need.left,y:need.top,w:nw,h:nh};report.push({id:proposal.trackIds[i],exactAspect:exact,sourceRect:r});return{...slot,sourceRect:r};});fs.writeFileSync(out+'/proposal.json',JSON.stringify({proposal,report},null,2));const filter=buildPanelsFilter(proposal.panels,720,1280);execFileSync('ffmpeg',['-hide_banner','-loglevel','error','-y','-filter_complex_threads','1','-threads','1','-i',prior.source,'-filter_complex','[0:v]'+filter+'[out]','-map','[out]','-map','0:a?','-t','14','-c:v','libx264','-threads','1','-preset','ultrafast','-crf','23','-c:a','aac',out+'/offline-tight-contain.mp4']);console.log(JSON.stringify(report));
