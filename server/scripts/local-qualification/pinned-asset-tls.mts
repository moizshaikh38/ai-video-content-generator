import crypto from'node:crypto';import fs from'node:fs';import https from'node:https';import dns from'node:dns/promises';import assert from'node:assert/strict';import path from'node:path';
import{pinnedHttpsAssetFetch}from'../../src/utils/pinnedHttpsAssetFetch.js';import{readBoundedAssetResponse}from'../../src/utils/boundedAssetResponse.js';import{ProEditorService}from'../../src/services/proEditorService.js';import{config}from'../../src/config/index.js';
const out='/downloads/vireo-pinned-tls-0205';fs.mkdirSync(out,{recursive:true});const cert='/tmp/vireo-local-tls-0205';let gets=0,redirectHits=0,lookups=0;const bytes=Buffer.from('synthetic overlay bytes');const server=https.createServer({key:fs.readFileSync(cert+'/key.pem'),cert:fs.readFileSync(cert+'/cert.pem')},(req,res)=>{gets++;if(req.url==='/redirect'){redirectHits++;res.writeHead(302,{location:'https://127.0.0.1:1/never-follow'});res.end();return}if(req.url==='/oversize'){res.writeHead(200,{'content-length':String(17*1024*1024)});res.end('x');return}if(req.url==='/stall'){res.write('a');return}res.end(bytes)});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));const address=server.address()as any;const url=`https://localhost:${address.port}`;const originalLookup=dns.lookup,originalProduction=config.isProduction;const results:any[]=[];
try{
 dns.lookup=(async(...args:any[])=>{lookups++;return (originalLookup as any)(...args)})as any;
 const response=await pinnedHttpsAssetFetch(url+'/ok',AbortSignal.timeout(2000));assert.equal((await readBoundedAssetResponse(response)).toString(),bytes.toString());assert.equal(lookups,1);results.push({case:'actual TLS preserves host identity and exact bytes',passed:true,systemDnsLookups:lookups});
 const redirect=await pinnedHttpsAssetFetch(url+'/redirect',AbortSignal.timeout(2000));assert.equal(redirect.status,302);await redirect.body?.cancel();assert.equal(redirectHits,1);assert.equal(gets,2);results.push({case:'302 returned without a second request',passed:true});
 const previous=gets;(config as any).isProduction=true;await assert.rejects(pinnedHttpsAssetFetch(url+'/private-block',AbortSignal.timeout(2000)),{code:'SSRF_BLOCKED'});assert.equal(gets,previous);(config as any).isProduction=originalProduction;results.push({case:'production private DNS result refused before TLS request',passed:true});
 await assert.rejects(readBoundedAssetResponse(await pinnedHttpsAssetFetch(url+'/stall',AbortSignal.timeout(150))));results.push({case:'actual stalled TLS body aborted',passed:true});
 const project:any={user_id:'fixture-owner',tracks:[{items:[{id:'a/../../escaped-'+crypto.randomUUID(),source_path:url+'/ok'}]}]};await ProEditorService.preloadRemoteOverlayAssets(project,out);const cached=project.tracks[0].items[0].source_path;assert.equal(path.dirname(cached),out);assert.deepEqual(fs.readFileSync(cached),bytes);results.push({case:'actual preload service writes bounded response to contained hashed filename',passed:true});
 const bad:any={user_id:'fixture-owner',tracks:[{items:[{id:'too-large',source_path:url+'/oversize'}]}]};await ProEditorService.preloadRemoteOverlayAssets(bad,out);assert.equal(bad.tracks[0].items[0].source_path,url+'/oversize');results.push({case:'actual preload rejects declared oversize without publishing cache',passed:true});
 fs.writeFileSync(out+'/result.json',JSON.stringify({status:'passed',results,actualHttps:true,localCertificateTrustOnly:true,tlsVerificationDisabled:false,devLoopbackExemption:true,productionDnsPrivateRejection:true,totalTlsRequests:gets,excluded:['real public CDN','production deployment','arbitrary internet DNS rebinding attack','media encode']},null,2));console.log('PINNED_TLS_INTEGRATION_PASS',out);
}finally{dns.lookup=originalLookup;(config as any).isProduction=originalProduction;server.closeAllConnections();await new Promise<void>(r=>server.close(()=>r()));}
