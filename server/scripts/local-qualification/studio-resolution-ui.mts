import fs from'node:fs';import assert from'node:assert/strict';import{createServer}from'vite';
const out='/downloads/vireo-studio-ordinary-0105';const vite=await createServer({server:{host:'127.0.0.1',port:5216,strictPort:true},appType:'custom'});vite.middlewares.use('/qualification-resolution.html',async(req,res)=>{res.setHeader('Content-Type','text/html');res.end(await vite.transformIndexHtml(req.url||'','<html><body><div id="root"></div><script type="module" src="/src/harness/localQualificationStudio.tsx"></script></body></html>'));});await vite.listen();let browser:any;
try{const pp=await import('/tmp/vireo-local-restore/ui-driver/node_modules/puppeteer-core/lib/puppeteer/puppeteer-core.js');browser=await pp.default.launch({executablePath:'/usr/bin/google-chrome',headless:true,args:['--no-sandbox','--disable-dev-shm-usage'],defaultViewport:{width:900,height:1000}});const page=await browser.newPage();await page.setRequestInterception(true);const errors:string[]=[];page.on('pageerror',e=>errors.push(e.message));page.on('request',r=>new URL(r.url()).hostname==='127.0.0.1'&&r.method()==='GET'?r.continue():r.abort());await page.goto('http://127.0.0.1:5216/qualification-resolution.html?resolutionOnly=1',{waitUntil:'domcontentloaded',timeout:60000});await page.waitForFunction(()=>document.body.innerText.includes('720p HD'));const selected=await page.evaluate(()=>[...document.querySelectorAll('button')].filter(b=>b.className.includes('ring-1')).map(b=>b.textContent?.trim()));assert.equal(selected.length,1);assert(selected[0]?.startsWith('720p HD'));assert.deepEqual(errors,[]);await page.screenshot({path:out+'/draft-720p-selected-after-fix.png'});fs.writeFileSync(out+'/draft-resolution-browser.json',JSON.stringify({actualExportDialog:true,fixture:'draft clip configured720p with no completed resolution metadata',selected,errors,noRenderOrDatabase:true},null,2));console.log('DRAFT_720P_ACTUAL_DIALOG_PASS');}finally{if(browser)await browser.close();await vite.close();}
