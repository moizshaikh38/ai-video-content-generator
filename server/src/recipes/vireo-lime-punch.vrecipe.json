{
  "$schema": "https://vireoclip.ai/schemas/vrecipe-v1.json",
  "id": "vireo-lime-punch",
  "name": "Vireo Lime Punch",
  "description": "Electric lime green high-contrast viral highlight with black outline and drop shadow.",
  "version": "1.0.0",
  "author": "VireoClip Native",
  "typography": {
    "fontFamily": "Arial Black",
    "fontSize": 86,
    "fontWeight": "bold",
    "letterSpacing": 0,
    "textCase": "uppercase"
  },
  "positioning": {
    "alignment": 2,
    "verticalMargin": 260,
    "horizontalMargin": 60,
    "maxWordsPerLine": 3,
    "maxCharsPerLine": 12,
    "lineBreakMethod": "balanced"
  },
  "colors": {
    "primary": "#FFFFFF",
    "secondary": "#CCCCCC",
    "activeWordHighlight": "#CCFF00",
    "outline": "#000000",
    "outlineWidth": 6,
    "shadow": "#00000099",
    "shadowOffset": 3
  },
  "animation": {
    "preset": "pop",
    "durationMs": 140,
    "activeWordScale": 1.15,
    "karaokeEffect": "jump"
  },
  "decorations": {
    "emojisEnabled": true,
    "autoHighlightKeywords": true
  }
}
