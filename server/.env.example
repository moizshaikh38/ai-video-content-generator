# Server-only development template. Never commit actual credentials.
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Supabase Auth only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# MongoDB Atlas application database
MONGODB_URI=mongodb+srv://app-user:replace-me@dev-cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vireo_dev

# Cloudflare R2 private buckets
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-bucket-scoped-access-key-id
R2_SECRET_ACCESS_KEY=your-bucket-scoped-secret-access-key
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
R2_SOURCE_BUCKET=vireo-source-videos-dev
R2_CLIPS_BUCKET=vireo-rendered-clips-dev
SMART_REFRAME_ENABLED=false

TRANSCRIPTION_PROVIDER=openrouter
TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
DEFAULT_MONTHLY_QUOTA_MINUTES=15

# Razorpay Standard Checkout
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# GIPHY API Configuration (Stickers & GIFs)
GIPHY_API_KEY=your_giphy_api_key_here


# Optional bounded model-judged final speech admission. Off by default.
# Requires BOTH settings; does not change the legacy text-model default.
# OPENROUTER_TEXT_MODEL=openai/gpt-4.1-mini
# VIREO_FINAL_SPEECH_ADMISSION=gpt-4.1-mini
# Adds one bounded review call per eligible selection, requests existing strict
# data-policy filters, and can return no-eligible/review failure without replacing
# suggestions. Model judgments are not a guarantee of publishability.
# Qualified DEV run only, not an independent holdout benchmark.
