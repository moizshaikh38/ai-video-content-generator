import test from 'node:test';
import assert from 'node:assert/strict';
import React from 'react';
import {renderToStaticMarkup} from 'react-dom/server';
import {TikTokComposerConstraints,emptyTikTokSelection} from '../src/components/TikTokComposerConstraints.tsx';
import {parseTikTokCreatorOptions,selectedTikTokPrivacy} from '../server/src/shared/tiktokCreatorOptions.ts';
import fs from 'node:fs';
import ts from 'typescript';
const raw={creator_nickname:'Fixture Creator',creator_username:'fixture_creator',privacy_level_options:['FOLLOWER_OF_CREATOR','MUTUAL_FOLLOW_FRIENDS','SELF_ONLY'],comment_disabled:false,duet_disabled:true,stitch_disabled:false,max_video_post_duration_sec:90};
const creator=parseTikTokCreatorOptions(raw)!;
const markup=(options:any={})=>renderToStaticMarkup(React.createElement(TikTokComposerConstraints,{creator,loading:false,error:null,selection:emptyTikTokSelection(),onChange:()=>{},onRefresh:()=>{},...options}));
test('creator options retain exact returned audience order and capability booleans',()=>{assert.deepEqual(creator.privacyLevels,raw.privacy_level_options);assert.equal(creator.maxVideoSeconds,90);assert.equal(creator.duetDisabled,true);});
test('unknown/missing/malformed creator fields cannot imply readiness',()=>{for(const change of [{privacy_level_options:[]},{privacy_level_options:['NEW_PRIVACY']},{privacy_level_options:['SELF_ONLY','SELF_ONLY']},{comment_disabled:undefined},{stitch_disabled:'false'},{max_video_post_duration_sec:0},{max_video_post_duration_sec:1.1},{creator_nickname:''},{creator_username:undefined}])assert.equal(parseTikTokCreatorOptions({...raw,...change}),null);});
test('no implicit private choice; supported legacy choices remain explicit',()=>{assert.equal(selectedTikTokPrivacy({}),null);assert.equal(selectedTikTokPrivacy({privacy:'private'}),'SELF_ONLY');assert.equal(selectedTikTokPrivacy({privacy:'public'}),'PUBLIC_TO_EVERYONE');assert.equal(selectedTikTokPrivacy({privacy:'private',platform_custom:{tiktok_privacy_level:''}}),null);});
test('no checked interaction or privacy default in actual component markup',()=>{const html=markup();assert.doesNotMatch(html,/checked=""/);assert.match(html,/<option value="" disabled="" selected="">Choose an audience/);assert.match(html,/Posting to Fixture Creator/);assert.match(html,/90 seconds/);assert.doesNotMatch(html,/<option value="PUBLIC_TO_EVERYONE"/);assert.match(html,/Allow Duet.*disabled by this account/s);});
test('loading and scope failures display honest blockers, no synthesized options',()=>{const html=markup({creator:null,error:'Upload-only permission cannot query Direct Post options.'});assert.match(html,/role="alert"/);assert.doesNotMatch(html,/<select/);assert.match(markup({creator:null,loading:true}),/Nothing is ready to submit/);});
test('fresh selected account changes are generation-gated; caption edits do not load creator info',()=>{const source=fs.readFileSync('src/components/PublishModal.tsx','utf8');assert.match(source,/tiktokGeneration.current!==generation/);assert.match(source,/result.connectionId!==selectedAccount.id/);assert.match(source,/\[isOpen,selectedConnectionId,tiktokRefresh,selectedAccount,loadingAccounts\]/);assert.match(source,/tiktokOptions\?\.connectionId===selectedConnectionId/);assert.match(source,/selectedAccount\?\.provider==='tiktok'&&!tiktokReady/);});
const source=fs.readFileSync('server/src/services/publishingService.ts','utf8');const ast=ts.createSourceFile('service.ts',source,ts.ScriptTarget.Latest,true);let method='';function visit(n:ts.Node){if(ts.isMethodDeclaration(n)&&n.name.getText(ast)==='getTikTokComposerOptions')method=n.getText(ast);ts.forEachChild(n,visit);}visit(ast);assert(method);
const js=ts.transpileModule(`export function fixture(d:any){const {getMongoDb,AppError,socialPublishingRegistry,decryptToken}=d;return new class{${method}}}`,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ESNext}}).outputText;
const {fixture}=await import('data:text/javascript;base64,'+Buffer.from(js).toString('base64'));
class AppError extends Error{constructor(message:string,public statusCode:number,public code:string){super(message);}}
function service(overrides:any={}){const reads:any[]=[],events:string[]=[];const conn={id:'selected',user_id:'owner',provider:'tiktok',provider_account_id:'bound-account',status:'connected',scopes:['video.publish'],access_token:'encrypted-fixture',...overrides};const db={collection:(name:string)=>({findOne:async(filter:any)=>{reads.push([name,filter]);return conn.id===filter.id&&conn.user_id===filter.user_id?conn:null;}})};const s=fixture({getMongoDb:async()=>db,AppError,decryptToken:()=>{events.push('decrypt');return'fixture-only';},socialPublishingRegistry:{getProvider:()=>({getCreatorOptions:async()=>{events.push('creator-read');return creator;}})}});return{reads,events,run:()=>s.getTikTokComposerOptions('owner','selected')};}
test('actual service scopes selected connection read to authenticated owner then returns safe creator options',async()=>{const s=service(),r=await s.run();assert.deepEqual(s.reads,[['social_account_connections',{id:'selected',user_id:'owner'}]]);assert.deepEqual(s.events,['decrypt','creator-read']);assert.equal(r.connectionId,'selected');assert.equal(r.providerAccountId,'bound-account');assert(!JSON.stringify(r).includes('encrypted-fixture'));});
for(const [name,change,code]of [['foreign owner',{user_id:'other'},'CONNECTION_NOT_FOUND'],['other provider',{provider:'instagram'},'CONNECTION_NOT_FOUND'],['revoked',{status:'revoked'},'TIKTOK_CONNECTION_NOT_READY'],['upload-only',{scopes:['video.upload']},'TIKTOK_DIRECT_POST_SCOPE_REQUIRED'],['missing grant',{scopes:[]},'TIKTOK_DIRECT_POST_SCOPE_REQUIRED'],['malformed grant',{scopes:'video.publish'},'TIKTOK_DIRECT_POST_SCOPE_REQUIRED'],['expired',{token_expires_at:new Date(0)},'TIKTOK_CONNECTION_NOT_READY']] as const)test(`actual creator route service refuses ${name} before decrypt or provider`,async()=>{const s=service(change);await assert.rejects(s.run(),{code});assert.equal(s.events.length,0);});
test('overlong and unverified clip durations are visible blockers',()=>{assert.match(markup({mediaDurationSeconds:91}),/Too long for this account/);assert.match(markup(),/Video duration has not been verified/);});
