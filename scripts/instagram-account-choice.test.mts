import test from 'node:test';
import assert from 'node:assert/strict';
import React from 'react';
import {renderToStaticMarkup} from 'react-dom/server';
import fs from 'node:fs';
import {InstagramAccountChoice} from '../src/components/InstagramAccountChoice.tsx';
const selection={selectionId:'fixture-selection',expiresAt:'2026-11-20T00:00:00+05:30',replacesAccountId:'11',choices:[{providerAccountId:'22',accountName:'Fixture Studio',username:'fixture_studio',pageId:'101',pageName:'Studio Page'},{providerAccountId:'33',accountName:'Fixture Personal Creator',username:'fixture_creator',pageId:'102',pageName:'Creator Page'}]};
const markup=(options:any={})=>renderToStaticMarkup(React.createElement(InstagramAccountChoice,{selection,loading:false,busy:false,error:null,selectedId:'',replacementConfirmed:false,onSelect:()=>{},onReplacementConfirmed:()=>{},onConfirm:()=>{},onCancel:()=>{},...options}));
test('all account/page identities shown and none chosen by default',()=>{const html=markup();assert.match(html,/Fixture Studio/);assert.match(html,/Fixture Personal Creator/);assert.match(html,/Page: Studio Page/);assert.match(html,/Instagram ID: 22/);assert.doesNotMatch(html,/checked=""/);assert.match(html,/Confirm selected account/);assert.match(html,/No account has been connected or replaced/);});
test('replacement destination requires separate acknowledgement and existing account is visible',()=>{const html=markup({selectedId:'22'});assert.match(html,/Existing destination account ID:/);assert.match(html,/I approve replacing/);assert.match(html,/Existing scheduled posts will not be redirected/);assert.match(html,/<button type="button" disabled=""[^>]*>Confirm selected account/);const allowed=markup({selectedId:'22',replacementConfirmed:true});assert.doesNotMatch(allowed,/<button type="button" disabled=""[^>]*>Confirm selected account/);});
test('same account reconnect is explicit but not falsely called replacement',()=>{const html=markup({selection:{...selection,replacesAccountId:'22'},selectedId:'22'});assert.doesNotMatch(html,/I approve replacing/);});
test('failed/expired load can be cancelled but never confirmed',()=>{const html=markup({selection:null,error:'Selection expired. Existing connection unchanged.'});assert.match(html,/role="alert"/);assert.match(html,/<button type="button" disabled=""[^>]*>Confirm selected account/);assert.match(html,/Cancel, keep existing connection/);});
test('callback selection redirect cannot imply connected success or leak provider token',()=>{const source=fs.readFileSync('server/src/controllers/socialController.ts','utf8');assert.match(source,/'selectionId' in result/);assert.match(source,/instagram_selection=\$\{encodeURIComponent\(result.selectionId\)\}/);const block=source.slice(source.indexOf("if('selectionId'"),source.indexOf('// Redirect user back'));assert.doesNotMatch(block,/accessToken|access_token|social_connected=/);});
test('existing OAuth entry uses explicit selection before legacy auto identity resolution',()=>{const source=fs.readFileSync('server/src/services/socialService.ts','utf8');assert(source.indexOf("if(platform==='instagram')return instagramAccountSelectionService.prepare")<source.indexOf('const identity = await provider.getAccountIdentity'));});
test('selection endpoints require authenticated owner and cancellation is pending-only',()=>{const source=fs.readFileSync('server/src/routes/socialRoutes.ts','utf8');for(const path of ['selections/:selectionId','selections/:selectionId/confirm','selections/:selectionId/cancel'])assert(source.includes(path+"',requireAuth"));const impl=fs.readFileSync('server/src/services/instagramAccountSelectionService.ts','utf8');assert.match(impl,/kind:'instagram-account-selection',selection_status:'pending'/);assert.match(impl,/withTransaction/);assert.match(impl,/writeConcern:\{w:'majority'\}/);});
