import test from 'node:test';
import assert from 'node:assert/strict';
import React from 'react';
import {renderToStaticMarkup} from 'react-dom/server';
import {PublishOutcomeBadge,PublishOutcomeDetails} from '../src/components/PublishOutcomeDetails.tsx';
import {postingOutcomeView,type PostingOutcomeInput} from '../src/shared/postingOutcomeView.ts';
import fs from 'node:fs';
const base:PostingOutcomeInput={status:'published',provider:'instagram',provider_account_id:'fixture-account-8',provider_post_id:'fixture-receipt',payload:{privacy:'public'}};
const render=(p:PostingOutcomeInput)=>renderToStaticMarkup(React.createElement('section',null,React.createElement(PublishOutcomeBadge,{post:p}),React.createElement(PublishOutcomeDetails,{post:p})));
test('published with attachment warning stays published and never retryable',()=>{const p={...base,last_error_code:'PUBLISHED_REVIEW_REQUIRED',last_error_message:'Caption settings need review on the selected account.'};const view=postingOutcomeView(p),html=render(p);assert.equal(view.statusLabel,'Published');assert.equal(view.tone,'warning');assert.equal(view.canRetry,false);assert.match(html,/Published, review details/);assert.match(html,/role="status"/);assert.doesNotMatch(html,/Error:|Failed|role="alert"/);});
test('unknown delivery is not failed/publication evidence and offers no resend',()=>{const p={...base,status:'failed',last_error_code:'PUBLISH_OUTCOME_UNKNOWN',provider_post_url:'https://example.test/saved-link'};const v=postingOutcomeView(p),html=render(p);assert.equal(v.statusLabel,'Delivery unconfirmed');assert.equal(v.tone,'warning');assert.equal(v.canRetry,false);assert.equal(v.verifiedLink,null);assert.match(html,/Do not submit it again/);assert.doesNotMatch(html,/>Failed</);});
test('processing remains awaiting platform confirmation',()=>{const p={...base,status:'publishing'},v=postingOutcomeView(p);assert.equal(v.statusLabel,'Awaiting confirmation');assert.equal(v.canRetry,false);assert.match(render(p),/This is not confirmed publication/);});
test('legacy requested audience is unknown, not defaulted public/private',()=>{const v=postingOutcomeView({...base,payload:{}});assert.equal(v.visibility,'Not recorded');});
for(const [provider,privacy,label]of [['instagram','public','Account audience (requested)'],['youtube','public','Public (requested)'],['tiktok','private','Private (requested)'],['youtube','unlisted','Unlisted (requested)']])test(`saved ${provider}/${privacy} is labelled requested, not remotely verified`,()=>assert.equal(postingOutcomeView({...base,provider,payload:{privacy}}).visibility,label));
test('saved account ID is used without rediscovering or substituting a different account',()=>{assert.match(render(base),/instagram account ID: fixture-account-8/);assert.equal(postingOutcomeView({...base,provider_account_id:null}).destination,'Selected account ID not recorded');});
test('no URL is fabricated from platform ID, receipt is labelled separately',()=>{const v=postingOutcomeView(base),html=render(base);assert.equal(v.verifiedLink,null);assert.equal(v.receipt,'fixture-receipt');assert.match(html,/Platform receipt:/);assert.match(html,/No public link returned/);assert.doesNotMatch(html,/href=/);});
test('private confirmed TikTok may have no public ID or URL',()=>{const p={...base,provider:'tiktok',provider_post_id:null,payload:{privacy:'private'}};assert.equal(postingOutcomeView(p).receipt,null);assert.match(render(p),/Private posts may not have a public link/);assert.equal(postingOutcomeView(p).canRetry,false);});
test('saved published HTTPS link passes only after confirmation',()=>{const p={...base,provider_post_url:'https://example.test/a?b=c'};assert.equal(postingOutcomeView(p).verifiedLink,p.provider_post_url);for(const status of ['scheduled','publishing','failed','cancelled','draft'])assert.equal(postingOutcomeView({...p,status}).verifiedLink,null);});
test('unsafe URL schemes and credentialed links cannot render viewing action',()=>{for(const provider_post_url of ['javascript:alert(1)','data:text/html,test','http://example.test/post','https://user:pass@example.test/post','/relative','invalid'])assert.equal(postingOutcomeView({...base,provider_post_url}).verifiedLink,null);});
test('provider text remains escaped markup, never rendered HTML',()=>{const html=render({...base,last_error_message:'<img src=x onerror=alert(1)>',provider_account_id:'<script>bad</script>'});assert.doesNotMatch(html,/<img|<script>/);assert.match(html,/&lt;img/);});
test('definitive error uses alert; retry remains an explicit action only',()=>{const p={...base,status:'failed',last_error_code:'PUBLISH_MEDIA_CHANGED',last_error_message:'Selected output changed.'},v=postingOutcomeView(p),html=render(p);assert.equal(v.statusLabel,'Failed');assert.equal(v.canRetry,true);assert.match(html,/role="alert"/);assert.match(html,/Publishing error/);});
test('contradictory published+unknown evidence never downgrades or authorizes resend',()=>{const v=postingOutcomeView({...base,last_error_code:'PUBLISH_OUTCOME_UNKNOWN'});assert.equal(v.statusLabel,'Published');assert.equal(v.tone,'warning');assert.equal(v.canRetry,false);});
test('cancelled and scheduled ordinary states are not errors',()=>{for(const status of ['scheduled','cancelled','draft']){const v=postingOutcomeView({...base,status});assert.equal(v.tone,'neutral');assert.equal(v.feedback,null);assert.equal(v.canRetry,false);}});
test('history uses same actual badge/details and gates actions on presentation output',()=>{const source=fs.readFileSync('src/pages/PublishingHistoryPage.tsx','utf8');assert.match(source,/<PublishOutcomeBadge post=\{post\}/);assert.match(source,/<PublishOutcomeDetails post=\{post\}/);assert.match(source,/outcome\.verifiedLink &&/);assert.match(source,/outcome\.canRetry &&/);assert.doesNotMatch(source,/Error: \{post\.last_error_message\}/);});
test('unknown saved status is not guessed to mean draft or published',()=>{const v=postingOutcomeView({...base,status:'unexpected'});assert.equal(v.statusLabel,'Unknown saved status');assert.equal(v.verifiedLink,null);assert.equal(v.canRetry,false);});
test('queue acknowledgement never claims confirmed publication',()=>{const source=fs.readFileSync('src/components/PublishModal.tsx','utf8');assert.match(source,/Publishing queued\. Publication is not yet confirmed/);assert.doesNotMatch(source,/Post is publishing in the background/);});
