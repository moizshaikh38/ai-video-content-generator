import test from 'node:test';
import assert from 'node:assert/strict';
import React from 'react';
import {renderToStaticMarkup} from 'react-dom/server';
import fs from 'node:fs';
import ts from 'typescript';
import {tikTokCommercialErrors,tikTokMusicDeclaration,tikTokCommercialSelection} from '../server/src/shared/tiktokCommercialDisclosure.ts';
import {assertReviewedPublishMedia,selectPublishMedia,assertPublishMediaSelection} from '../server/src/shared/publishMediaSelection.ts';
import {PublishRenderedReview} from '../src/components/PublishRenderedReview.tsx';
import {TikTokComposerConstraints,emptyTikTokSelection} from '../src/components/TikTokComposerConstraints.tsx';
const creator={nickname:'Fixture Creator',username:'fixture_creator',privacyLevels:['PUBLIC_TO_EVERYONE','MUTUAL_FOLLOW_FRIENDS','SELF_ONLY'] as const,commentDisabled:false,duetDisabled:false,stitchDisabled:false,maxVideoSeconds:60};
const renderCommercial=(change:any={})=>renderToStaticMarkup(React.createElement(TikTokComposerConstraints,{creator:{...creator,privacyLevels:[...creator.privacyLevels]},loading:false,error:null,selection:{...emptyTikTokSelection(),...change},onChange:()=>{},onRefresh:()=>{}}));
test('disclosure off by default, no implicit brand labels',()=>{assert.deepEqual(tikTokCommercialSelection({}),{disclose:false,ownBrand:false,brandedContent:false});assert.doesNotMatch(renderCommercial(),/checked=""/);assert.doesNotMatch(renderCommercial(),/labelled Promotional content|labelled Paid partnership/);});
test('disclosure on without category blocks, categories cannot hide under off toggle',()=>{assert.equal(tikTokCommercialErrors({disclose:true,ownBrand:false,brandedContent:false},'SELF_ONLY').length,1);assert.equal(tikTokCommercialErrors({disclose:false,ownBrand:true,brandedContent:false},'SELF_ONLY').length,1);});
test('own-brand is Promotional content and third-party/both are Paid partnership',()=>{assert.match(renderCommercial({disclose:true,ownBrand:true}),/labelled Promotional content/);assert.match(renderCommercial({disclose:true,brandedContent:true}),/labelled Paid partnership/);assert.match(renderCommercial({disclose:true,ownBrand:true,brandedContent:true}),/labelled Paid partnership/);assert.doesNotMatch(renderCommercial({disclose:true,ownBrand:true,brandedContent:true}),/labelled Promotional content/);});
test('private branded content cannot silently switch to public',()=>{assert.equal(tikTokCommercialErrors({disclose:true,ownBrand:false,brandedContent:true},'SELF_ONLY').length,1);assert.equal(tikTokCommercialErrors({disclose:true,ownBrand:false,brandedContent:true},'MUTUAL_FOLLOW_FRIENDS').length,0);assert.equal(tikTokCommercialErrors({disclose:true,ownBrand:false,brandedContent:true},'FOLLOWER_OF_CREATOR').length,1);assert.match(renderCommercial({disclose:true,privacy:'SELF_ONLY'}),/Branded content requires Everyone or Friends/);assert.match(renderCommercial({disclose:true,brandedContent:true}),/value="SELF_ONLY" disabled=""/);});
test('third-party consent declaration changes and own-brand remains ordinary music consent',()=>{assert.match(tikTokMusicDeclaration(true),/Branded Content Policy and Music/);assert.doesNotMatch(tikTokMusicDeclaration(false),/Branded Content Policy/);assert.match(renderCommercial({disclose:true,brandedContent:true}),/Branded Content Policy and Music/);});
const clip={id:'clip',user_id:'owner',project_id:'project',render_status:'ready',output_storage_path:'immutable',render_version:3,editor_version:4,duration_seconds:12};const head={size:42,etag:'bytes',versionId:'version'};const selection=selectPublishMedia(clip,head);
test('exact reviewed immutable selection accepted, any changed field refuses',()=>{assert.doesNotThrow(()=>assertReviewedPublishMedia(structuredClone(selection),selection));for(const change of [{clipId:'other'},{owner:'other'},{projectId:'other'},{objectKey:'replaced'},{bytes:43},{etag:'new'},{renderVersion:4},{editorVersion:5},{objectVersionId:'new'}])assert.throws(()=>assertReviewedPublishMedia({...selection,...change},selection),{code:'PUBLISH_MEDIA_CHANGED'});for(const v of [null,undefined,{},'url'])assert.throws(()=>assertReviewedPublishMedia(v,selection));});
const renderReview=(change:any={})=>renderToStaticMarkup(React.createElement(PublishRenderedReview,{url:'https://example.test/fixture.mp4',loading:false,error:null,mediaLoaded:false,reviewed:false,renderVersion:3,onLoaded:()=>{},onError:()=>{},onReviewed:()=>{},onRefresh:()=>{},...change}));
test('exact video is controlled, never autoplayed, review stays disabled until media loads',()=>{const html=renderReview();assert.match(html,/<video/);assert.match(html,/controls=""/);assert.doesNotMatch(html,/autoPlay|autoplay/);assert.match(html,/type="checkbox" disabled=""/);assert.match(html,/does not upload to TikTok/);assert.match(renderReview({error:'Cannot play selected output.',url:null}),/role="alert"/);assert.doesNotMatch(renderReview({url:null}),/type="checkbox"/);});
test('review consent resets with post decisions and binds selected immutable identity in payload',()=>{const source=fs.readFileSync('src/components/PublishModal.tsx','utf8');assert.match(source,/setRenderReviewed\(false\).*\[title,caption,tags,tiktokSelection,publishMode,scheduleDate,scheduleTime,timezone,selectedConnectionId,tiktokRefresh\]/);assert.match(source,/tiktok_reviewed_media:currentRenderReviewed\?renderReview\?\.selection/);assert.match(source,/result.selection.clipId!==clipId\|\|result.selection.projectId!==projectId/);assert.match(source,/reviewGeneration.current!==generation/);assert.match(source,/reviewedDecisionKey===reviewDecisionKey/);});
const source=fs.readFileSync('server/src/services/publishingService.ts','utf8');const ast=ts.createSourceFile('service.ts',source,ts.ScriptTarget.Latest,true);let method='';function visit(n:ts.Node){if(ts.isMethodDeclaration(n)&&n.name.getText(ast)==='getPublishReview')method=n.getText(ast);ts.forEachChild(n,visit);}visit(ast);assert(method);
class AppError extends Error{constructor(message:string,public statusCode:number,public code:string){super(message);}}
const js=ts.transpileModule(`export function fixture(d:any){const {getMongoDb,AppError,selectPublishMedia,assertPublishMediaSelection,headObject,signObjectGet}=d;return new class{${method}}}`,{compilerOptions:{target:ts.ScriptTarget.ES2022,module:ts.ModuleKind.ESNext}}).outputText;const {fixture}=await import('data:text/javascript;base64,'+Buffer.from(js).toString('base64'));
function service(change:any={},current:any=null){const calls:any[]=[];let reads=0;const row={...clip,...change};return{calls,run:()=>fixture({AppError,selectPublishMedia,assertPublishMediaSelection,getMongoDb:async()=>({collection:(name:string)=>({findOne:async (filter:any)=>{calls.push(['read',name,filter]);const c=++reads>1&&current?current:row;return c.id===filter.id&&c.user_id===filter.user_id?c:null;}})}),headObject:async(...args:any[])=>{calls.push(['head',...args]);return head;},signObjectGet:async(...args:any[])=>{calls.push(['sign',...args]);return'https://example.test/pinned-fixture.mp4';}}).getPublishReview('owner','project','clip')};}
test('actual review service owner-scopes clip and signs exact immutable object version',async()=>{const s=service(),r=await s.run();assert.deepEqual(r.selection,selection);assert.equal(r.durationSeconds,12);assert.deepEqual(s.calls.find(c=>c[0]==='sign')?.at(-1),{versionId:'version'});assert.equal(s.calls.filter(c=>c[0]==='read').length,2);});
for(const [name,change,code]of [['foreign owner',{user_id:'foreign'},'CLIP_NOT_FOUND'],['wrong project',{project_id:'other'},'CLIP_NOT_FOUND'],['not rendered',{render_status:'rendering'},'CLIP_NOT_READY']] as const)test(`review refuses ${name} before storage signing`,async()=>{const s=service(change);await assert.rejects(s.run(),{code});assert.equal(s.calls.filter(c=>c[0]==='sign'||c[0]==='head').length,0);});
test('replacement output during storage check cannot be signed as reviewed selection',async()=>{const s=service({}, {...clip,output_storage_path:'new-output'});await assert.rejects(s.run(),{code:'PUBLISH_MEDIA_CHANGED'});assert.equal(s.calls.filter(c=>c[0]==='sign').length,0);});
test('actual creation applies reviewed-selection check after storage selection before post insert',()=>{const a=source.indexOf("if(conn.provider==='tiktok')assertReviewedPublishMedia");assert(a>source.indexOf('mediaSelection=selectPublishMedia'));assert(a<source.indexOf('const fingerprint = this.generateFingerprint'));});
