# ========================================================
# Vireo AI Video Content Generator — Environment Variables
# Copy this file to .env or .env.local for local development.
# NEVER commit real credentials, service secrets, or .env files to Git.
# ========================================================

# ── Frontend Configuration (Client-side exposed via Vite) ─────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
VITE_API_URL=http://localhost:5000/api

# ── Backend Server Configuration ──────────────────────────────────
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# ── Supabase Server Admin Configuration (Server-Side Only) ────────
# Keep SUPABASE_SECRET_KEY strictly confidential (service_role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# ── MongoDB Atlas application data (backend only) ────────────────
# Use separate development and production databases and least-privilege app users.
MONGODB_URI=mongodb+srv://app-user:replace-me@dev-cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vireo_dev

# ── Private Cloudflare R2 buckets (backend only) ─────────────────
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-bucket-scoped-access-key-id
R2_SECRET_ACCESS_KEY=your-bucket-scoped-secret-access-key
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
R2_SOURCE_BUCKET=vireo-source-videos-dev
R2_CLIPS_BUCKET=vireo-rendered-clips-dev
SMART_REFRAME_ENABLED=false

# ── AI Services & Transcription Provider Configuration ────────────
# Transcription provider selection: 'groq' (default) or 'openrouter'
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional Model Configuration
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ── Usage Metering & Quotas ──────────────────────────────────────
# Default monthly processing limit in minutes for free tier accounts
DEFAULT_MONTHLY_QUOTA_MINUTES=15

# ── Timeouts & Processing Controls (Milliseconds / Minutes) ───────
PROCESSING_STALE_MINUTES=15
TRANSCRIPTION_TIMEOUT_MS=120000
CONTENT_GENERATION_TIMEOUT_MS=60000
FFMPEG_TIMEOUT_MS=180000
CLIP_RENDER_TIMEOUT_MS=300000

# ── Social OAuth & Account Connections (Phase 9) ──────────────────
# Authenticated AES-256-GCM encryption key for tokens at rest (32 bytes / 64 hex chars or random passphrase)
SOCIAL_TOKEN_ENCRYPTION_KEY=replace-with-a-secure-32-byte-secret-encryption-key

# YouTube / Google Cloud OAuth 2.0
# Requires: Google Cloud Project, YouTube Data API v3 enabled, OAuth Consent Screen configured
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/social/youtube/callback

# Instagram / Meta Graph API OAuth
# Requires: Meta Developer App with Facebook Login & Instagram Graph API product enabled
META_CLIENT_ID=your-meta-app-id
META_CLIENT_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:5000/api/social/instagram/callback

# TikTok Developer OAuth v2
# Requires: TikTok for Developers App with Login Kit enabled
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:5000/api/social/tiktok/callback

# LinkedIn OAuth 2.0
# Requires: LinkedIn Developer App with "Sign In with LinkedIn using OpenID Connect" & "Share on LinkedIn"
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/social/linkedin/callback

# X / Twitter OAuth 2.0 (with PKCE)
# Requires: X Developer Portal App with User Authentication settings (OAuth 2.0)
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
X_REDIRECT_URI=http://localhost:5000/api/social/x/callback

# ── Billing: Razorpay for India (IN), Paddle for every other supported country ──
# The gateway is chosen server-side from the customer's billing country; customers never pick it.
# Secrets stay server-side. Use test/sandbox credentials outside production.

# Razorpay (India, INR subscriptions)
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret
# Razorpay Plan IDs (Dashboard → Subscriptions → Plans). INR monthly prices come from planConfig.
RAZORPAY_PLAN_CREATOR_MONTHLY=plan_replace
RAZORPAY_PLAN_PRO_MONTHLY=plan_replace
RAZORPAY_PLAN_STUDIO_MONTHLY=plan_replace
# Optional yearly India billing: offered only when BOTH the plan id and its INR display price are set.
RAZORPAY_PLAN_CREATOR_YEARLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_STUDIO_YEARLY=
RAZORPAY_YEARLY_INR_CREATOR=
RAZORPAY_YEARLY_INR_PRO=
RAZORPAY_YEARLY_INR_STUDIO=

# Paddle Billing (all non-Indian supported countries, USD list prices)
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_replace
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace
PADDLE_CLIENT_TOKEN=test_replace
PADDLE_PRICE_CREATOR_MONTHLY=pri_replace
PADDLE_PRICE_CREATOR_YEARLY=pri_replace
PADDLE_PRICE_PRO_MONTHLY=pri_replace
PADDLE_PRICE_PRO_YEARLY=pri_replace
PADDLE_PRICE_STUDIO_MONTHLY=pri_replace
PADDLE_PRICE_STUDIO_YEARLY=pri_replace
# Buyer countries Paddle cannot serve (ISO alpha-2, comma-separated). Default mirrors Paddle's
# published unsupported list — confirm against Paddle before launch.
PADDLE_BLOCKED_COUNTRIES=AF,BY,CU,IR,IQ,KP,LY,RU,SD,SY,VE,YE,ZW

# Optional: a trusted edge header with the visitor's ISO country (e.g. cf-ipcountry behind
# Cloudflare). Only set this if your edge overwrites client-supplied copies of the header.
BILLING_TRUSTED_COUNTRY_HEADER=

# ── Giphy API Configuration (Stickers, Overlays & GIFs) ───────────
GIPHY_API_KEY=your_giphy_api_key_here
VITE_GIPHY_API_KEY=your_giphy_api_key_here

