# ========================================================
# AI Video Content Generator - Environment Configuration
# Copy this file to .env for local development
# NEVER commit real credentials or .env files to Git
# ========================================================

# Frontend Configuration (Client-side exposed via Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://localhost:5000/api

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Server/Admin Configuration (Keep Server-Side Only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Database Connection (PostgreSQL)
DATABASE_URL=

# S3 / Cloudflare R2 Object Storage (Server-Side Only)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Modular AI Service Provider (Server-Side Only)
AI_API_KEY=
OPENAI_API_KEY=

